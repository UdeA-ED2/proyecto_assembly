###############################################################################
# CALCULADORA EN ASSEMBLER RISC-V CON BATERÍA DE PRUEBAS AUTOMÁTICA
# (ENTREGA 3 - ORGANIZACIÓN DE COMPUTADORES)
###############################################################################

.global _start                        # Declaración de la etiqueta global de inicio

_start:                               # Punto de entrada principal para el enlazador

main:
    la    sp, tope_stack              # Cargar la dirección del final de la pila reservada en sp
    la    a0, msg_titulo              # Cargar la dirección del mensaje de bienvenida en a0
    jal   ra, ImprimirCadenaUART      # Imprimir el título de bienvenida por UART
    jal   ra, ejecutar_bateria_pruebas# Ejecutar la batería de pruebas automáticas de la Entrega 3

#------------------------------------------------------------------------------
# CICLO PRINCIPAL DE LA CALCULADORA INTERACTIVA
#------------------------------------------------------------------------------
ciclo_principal:
    la    a0, msg_prompt              # Cargar la dirección del indicador de entrada "> "
    jal   ra, ImprimirCadenaUART      # Imprimir el prompt por UART
    la    a0, buffer_entrada          # Cargar la dirección del buffer receptor en a0
    jal   ra, LeerLineaUART           # Leer línea digitada por el usuario hasta presionar Enter
    la    a0, buffer_entrada          # Pasar la dirección de la expresión leída en a0
    jal   ra, BuscarOperador          # Buscar el operador (+, -, *, /) en la cadena de texto
    addi  s0, a0, 0                   # Guardar el operador ASCII encontrado en s0
    addi  s1, a1, 0                   # Guardar el puntero al segundo operando en s1
    beq   s0, zero, error_operacion   # Si no se detectó operador válido, saltar a error

###############################################################################
# OPERANDO 1
###############################################################################
    la    a0, buffer_entrada          # Cargar puntero a la cadena ASCII del primer operando
    la    a1, bcd_op1                 # Cargar dirección de destino BCD para el operando 1
    jal   ra, ascii_a_bcd             # Convertir el texto ASCII del operando 1 a BCD expandido
    lw    t0, 0(a1)                   # Leer palabra 0 (código de estado) de la estructura BCD
    addi  t1, zero, 3                 # Cargar constante 3 (Underflow) en t1
    beq   t0, t1, error_underflow     # Si la conversión reportó Underflow (3), saltar a error
    la    a0, bcd_op1                 # Cargar dirección del número BCD operando 1
    jal   ra, bcd_a_float             # Convertir el número BCD a formato flotante IEEE-754
    fmv.x.w t0, fa0                   # Extraer los 32 bits flotantes de fa0 al registro entero t0
    fmv.w.x fs0, t0                   # Mover la representación de bits de t0 al registro flotante fs0

###############################################################################
# OPERANDO 2
###############################################################################
    addi  a0, s1, 0                   # Pasar puntero a la cadena ASCII del segundo operando
    la    a1, bcd_op2                 # Cargar dirección de destino BCD para el operando 2
    jal   ra, ascii_a_bcd             # Convertir el texto ASCII del operando 2 a BCD expandido
    lw    t0, 0(a1)                   # Leer palabra 0 (código de estado) de la estructura BCD
    addi  t1, zero, 3                 # Cargar constante 3 (Underflow) en t1
    beq   t0, t1, error_underflow     # Si la conversión reportó Underflow (3), saltar a error
    la    a0, bcd_op2                 # Cargar dirección del número BCD operando 2
    jal   ra, bcd_a_float             # Convertir el número BCD a formato flotante IEEE-754
    fmv.x.w t0, fa0                   # Extraer los 32 bits flotantes de fa0 al registro entero t0
    fmv.w.x fs1, t0                   # Mover la representación de bits de t0 al registro flotante fs1

###############################################################################
# SELECCIONAR OPERACIÓN
###############################################################################
    addi  t0, zero, 43                # Cargar código ASCII de '+' (43)
    beq   s0, t0, op_suma             # Si el operador es '+', ir a op_suma
    addi  t0, zero, 45                # Cargar código ASCII de '-' (45)
    beq   s0, t0, op_resta            # Si el operador es '-', ir a op_resta
    addi  t0, zero, 42                # Cargar código ASCII de '*' (42)
    beq   s0, t0, op_mult             # Si el operador es '*', ir a op_mult
    addi  t0, zero, 47                # Cargar código ASCII de '/' (47)
    beq   s0, t0, op_div              # Si el operador es '/', ir a op_div
    jal   zero, error_operacion       # Si no coincide con ninguno, ir a error de operación

#------------------------------------------------------------------------------
# OPERACIONES ARITMÉTICAS
#------------------------------------------------------------------------------
op_suma:
    fadd.s fa0, fs0, fs1              # Realizar la suma flotante: fa0 = fs0 + fs1
    jal   zero, procesar_resultado    # Saltar a procesar y mostrar el resultado

op_resta:
    fsub.s fa0, fs0, fs1              # Realizar la resta flotante: fa0 = fs0 - fs1
    jal   zero, procesar_resultado    # Saltar a procesar y mostrar el resultado

op_mult:
    fmul.s fa0, fs0, fs1              # Realizar la multiplicación flotante: fa0 = fs0 * fs1
    jal   zero, procesar_resultado    # Saltar a procesar y mostrar el resultado

op_div:
    fmv.x.w t0, fs1                   # Extraer los bits del divisor fs1 al registro entero t0
    la    t1, mascara_magnitud        # Cargar dirección de la máscara 0x7FFFFFFF
    lw    t1, 0(t1)                   # Leer el valor de la máscara desde memoria
    and   t0, t0, t1                  # Aplicar máscara para ignorar el bit de signo
    beq   t0, zero, error_division_cero # Si la magnitud es 0, saltar a error de división por cero
    fdiv.s fa0, fs0, fs1              # Realizar la división flotante: fa0 = fs0 / fs1
    jal   zero, procesar_resultado    # Saltar a procesar y mostrar el resultado

#------------------------------------------------------------------------------
# PROCESAR RESULTADO
#------------------------------------------------------------------------------
procesar_resultado:
    la    a0, msg_igual               # Cargar dirección de la cadena de texto " = "
    jal   ra, ImprimirCadenaUART      # Imprimir " = " por UART
    la    a0, bcd_res                 # Cargar dirección destino de la estructura BCD
    jal   ra, float_a_bcd             # Convertir el resultado flotante de fa0 a BCD
    lw    t0, 0(a0)                   # Leer código de estado obtenido en BCD
    addi  t1, zero, 2                 # Cargar constante 2 (Overflow/Error)
    beq   t0, t1, error_float         # Si la conversión retornó error 2, ir a error_float
    addi  t1, zero, 3                 # Cargar constante 3 (Underflow)
    beq   t0, t1, error_underflow     # Si retornó 3, ir a error_underflow
    la    a0, bcd_res                 # Cargar puntero del número BCD procesado
    jal   ra, bcd_a_ascii             # Convertir BCD a ASCII e imprimirlo por UART
    jal   zero, ciclo_principal       # Retornar al ciclo de la calculadora interactiva

#------------------------------------------------------------------------------
# ERRORES
#------------------------------------------------------------------------------
error_division_cero:
    la    a0, msg_division_cero       # Cargar mensaje de error de división por cero
    jal   ra, ImprimirCadenaUART      # Imprimir mensaje por UART
    jal   zero, ciclo_principal       # Volver al ciclo principal

error_float:
    la    a0, msg_error_float         # Cargar mensaje de error por Overflow/NaN
    jal   ra, ImprimirCadenaUART      # Imprimir mensaje por UART
    jal   zero, ciclo_principal       # Volver al ciclo principal

error_underflow:
    la    a0, msg_underflow           # Cargar mensaje de error por Underflow
    jal   ra, ImprimirCadenaUART      # Imprimir mensaje por UART
    jal   zero, ciclo_principal       # Volver al ciclo principal

error_operacion:
    la    a0, msg_error               # Cargar mensaje de operación inválida
    jal   ra, ImprimirCadenaUART      # Imprimir mensaje por UART
    jal   zero, ciclo_principal       # Volver al ciclo principal

###############################################################################
# BATERÍA DE PRUEBAS AUTOMÁTICA (ENTREGA 3)
###############################################################################
ejecutar_bateria_pruebas:
    addi  sp, sp, -36                 # Reservar 36 bytes en la pila para guardar contexto
    sw    ra, 0(sp)                   # Guardar registro de dirección de retorno ra
    sw    s0, 4(sp)                   # Guardar registro s0
    sw    s1, 8(sp)                   # Guardar registro s1
    sw    s2, 12(sp)                  # Guardar registro s2
    sw    s3, 16(sp)                  # Guardar registro s3
    sw    s4, 20(sp)                  # Guardar registro s4
    sw    s5, 24(sp)                  # Guardar registro s5
    sw    s6, 28(sp)                  # Guardar registro s6
    sw    s7, 32(sp)                  # Guardar registro s7

    la    a0, msg_titulo_pruebas      # Cargar título de la batería de pruebas
    jal   ra, ImprimirCadenaUART      # Imprimir el título por UART

    la    t0, num_pruebas             # Cargar dirección de la variable num_pruebas
    lw    s1, 0(t0)                   # s1 = total de pruebas a ejecutar
    addi  s0, zero, 0                 # s0 = contador de la prueba actual (inicia en 0)
    addi  s2, zero, 0                 # s2 = acumulador de pruebas pasadas exitosamente
    addi  s3, zero, 0                 # s3 = acumulador de errores detectados
    la    s4, tabla_pruebas           # s4 = puntero al inicio de la tabla de pruebas

bucle_pruebas:
    beq   s0, s1, fin_bateria_pruebas # Si contador == total, finalizar las pruebas

    lw    s5, 0(s4)                   # s5 = puntero a la cadena ASCII del operando 1
    lw    s6, 4(s4)                   # s6 = carácter del operador en formato ASCII
    lw    s7, 8(s4)                   # s7 = puntero a la cadena ASCII del operando 2

    addi  a0, s5, 0                   # Copiar puntero de operando 1 a a0
    la    a1, bcd_op1                 # Cargar dirección destino BCD
    jal   ra, ascii_a_bcd             # Convertir ASCII a BCD

    lw    t0, 0(a1)                   # Leer código de estado generado en BCD
    addi  t1, zero, 3                 # Cargar código 3 (Underflow)
    beq   t0, t1, es_und_in_test      # Si dio underflow al convertir, saltar

    la    a0, bcd_op1                 # Cargar puntero BCD
    jal   ra, bcd_a_float             # Convertir BCD a float
    fmv.x.w t0, fa0                   # Extraer representación de bits de fa0 a t0
    fmv.w.x fs0, t0                   # Pasar bits de t0 al registro flotante fs0

    addi  a0, s7, 0                   # Copiar puntero de operando 2 a a0
    la    a1, bcd_op2                 # Cargar dirección destino BCD
    jal   ra, ascii_a_bcd             # Convertir ASCII a BCD

    lw    t0, 0(a1)                   # Leer código de estado generado en BCD
    addi  t1, zero, 3                 # Cargar código 3 (Underflow)
    beq   t0, t1, es_und_in_test      # Si dio underflow al convertir, saltar

    la    a0, bcd_op2                 # Cargar puntero BCD
    jal   ra, bcd_a_float             # Convertir BCD a float
    fmv.x.w t0, fa0                   # Extraer representación de bits de fa0 a t0
    fmv.w.x fs1, t0                   # Pasar bits de t0 al registro flotante fs1

    addi  t0, zero, 43                # ASCII del carácter '+'
    beq   s6, t0, test_op_suma        # Si s6 == '+', ir a test_op_suma

    addi  t0, zero, 45                # ASCII del carácter '-'
    beq   s6, t0, test_op_resta       # Si s6 == '-', ir a test_op_resta

    addi  t0, zero, 42                # ASCII del carácter '*'
    beq   s6, t0, test_op_mult        # Si s6 == '*', ir a test_op_mult

    addi  t0, zero, 47                # ASCII del carácter '/'
    beq   s6, t0, test_op_div         # Si s6 == '/', ir a test_op_div

    addi  t0, zero, 2                 # Cargar código de error 2 si el operador es inválido
    j     evaluar_resultado           # Saltar a evaluar resultado

test_op_suma:
    fadd.s fa0, fs0, fs1              # Sumar los dos operandos de prueba
    j     procesar_res_test           # Ir a procesar el resultado de la prueba

test_op_resta:
    fsub.s fa0, fs0, fs1              # Restar los dos operandos de prueba
    j     procesar_res_test           # Ir a procesar el resultado de la prueba

test_op_mult:
    fmul.s fa0, fs0, fs1              # Multiplicar los dos operandos de prueba
    j     procesar_res_test           # Ir a procesar el resultado de la prueba

test_op_div:
    fmv.x.w t0, fs1                   # Copiar los bits del divisor fs1 al entero t0
    la    t1, mascara_magnitud        # Cargar dirección de la máscara
    lw    t1, 0(t1)                   # Cargar valor de la máscara 0x7FFFFFFF
    and   t0, t0, t1                  # Aislar la magnitud quitando el signo
    beq   t0, zero, es_div_zero_test  # Si la magnitud es 0, saltar a división por cero
    fdiv.s fa0, fs0, fs1              # Dividir los dos operandos de prueba
    j     procesar_res_test           # Ir a procesar el resultado de la prueba

es_div_zero_test:
    addi  t0, zero, 4                 # Asignar código de estado 4 (División por Cero)
    j     evaluar_resultado           # Saltar a evaluación de prueba

es_und_in_test:
    addi  t0, zero, 3                 # Asignar código de estado 3 (Underflow)
    j     evaluar_resultado           # Saltar a evaluación de prueba

procesar_res_test:
    la    a0, bcd_res                 # Cargar dirección de estructura BCD destino
    jal   ra, float_a_bcd             # Convertir resultado flotante en fa0 a BCD
    la    a0, bcd_res                 # Cargar puntero BCD
    lw    t0, 0(a0)                   # Leer código de estado resultante (0, 1, 2 o 3)

evaluar_resultado:
    addi  sp, sp, -4                  # Reservar 4 bytes en pila para preservar t0
    sw    t0, 0(sp)                   # Respaldar código de estado t0 en la pila

    addi  a0, s5, 0                   # Cargar puntero ASCII del primer operando
    jal   ra, ImprimirCadenaUART      # Imprimir operando 1

    addi  a0, zero, 32                # Cargar carácter espacio en blanco ' '
    jal   ra, WriteUART               # Imprimir espacio por UART

    addi  a0, s6, 0                   # Cargar carácter ASCII del operador
    jal   ra, WriteUART               # Imprimir operador por UART

    addi  a0, zero, 32                # Cargar carácter espacio en blanco ' '
    jal   ra, WriteUART               # Imprimir espacio por UART

    addi  a0, s7, 0                   # Cargar puntero ASCII del segundo operando
    jal   ra, ImprimirCadenaUART      # Imprimir operando 2

    la    a0, msg_igual               # Cargar cadena " = "
    jal   ra, ImprimirCadenaUART      # Imprimir " = " por UART

    lw    t0, 0(sp)                   # Recuperar código de estado t0 de la pila
    addi  sp, sp, 4                   # Liberar espacio reservado en pila

    addi  t2, zero, 4                 # Cargar código 4 (Div/0)
    beq   t0, t2, pr_res_div0         # Si t0 == 4, ir a imprimir mensaje corto Div/0

    addi  t2, zero, 2                 # Cargar código 2 (Overflow)
    beq   t0, t2, pr_res_ovf          # Si t0 == 2, ir a imprimir mensaje corto Overflow

    addi  t2, zero, 3                 # Cargar código 3 (Underflow)
    beq   t0, t2, pr_res_und          # Si t0 == 3, ir a imprimir mensaje corto Underflow

    la    a0, bcd_res                 # Cargar estructura BCD resultado
    jal   ra, bcd_a_ascii             # Imprimir el resultado numérico en ASCII
    j     pr_res_fin                  # Saltar a la finalización de línea

pr_res_div0:
    la    a0, msg_err_div0_short      # Cargar cadena "[ERROR] Div/0"
    jal   ra, ImprimirCadenaUART      # Imprimir por UART
    j     pr_res_fin                  # Saltar a finalización

pr_res_ovf:
    la    a0, msg_err_ovf_short       # Cargar cadena "[ERROR] Overflow"
    jal   ra, ImprimirCadenaUART      # Imprimir por UART
    j     pr_res_fin                  # Saltar a finalización

pr_res_und:
    la    a0, msg_err_und_short       # Cargar cadena "[ERROR] Underflow"
    jal   ra, ImprimirCadenaUART      # Imprimir por UART

pr_res_fin:
    la    a0, msg_newline             # Cargar salto de línea "\r\n"
    jal   ra, ImprimirCadenaUART      # Imprimir salto de línea

    lw    t1, 12(s4)                  # Cargar código esperado para la prueba actual desde la tabla

    addi  t2, zero, 4                 # Cargar constante 4
    bne   t1, t2, chk_not_divzero     # Si lo esperado no era Div/0, pasar a siguiente chequeo
    beq   t0, t2, test_paso           # Si el código obtenido es 4, prueba aprobada
    j     test_fallo                  # De lo contrario, prueba fallada

chk_not_divzero:
    addi  t2, zero, 2                 # Cargar constante 2
    bne   t1, t2, chk_not_overflow    # Si lo esperado no era Overflow, pasar a siguiente chequeo
    beq   t0, t2, test_paso           # Si el código obtenido es 2, prueba aprobada
    j     test_fallo                  # De lo contrario, prueba fallada

chk_not_overflow:
    addi  t2, zero, 3                 # Cargar constante 3
    bne   t1, t2, chk_not_underflow   # Si lo esperado no era Underflow, pasar a siguiente chequeo
    beq   t0, t2, test_paso           # Si el código obtenido es 3, prueba aprobada
    j     test_fallo                  # De lo contrario, prueba fallada

chk_not_underflow:
    addi  t2, zero, 2                 # Cargar constante 2
    beq   t0, t2, test_fallo          # Si obtuvo error 2 inesperado, fallar
    addi  t2, zero, 3                 # Cargar constante 3
    beq   t0, t2, test_fallo          # Si obtuvo error 3 inesperado, fallar
    addi  t2, zero, 4                 # Cargar constante 4
    beq   t0, t2, test_fallo          # Si obtuvo error 4 inesperado, fallar

    lw    t3, 16(s4)                  # Cargar puntero al valor flotante esperado de la prueba
    # REEMPLAZO 1 DE FLW: flw ft0, 0(t3) -> lw + fmv.w.x
    lw    t4, 0(t3)                   # Leer palabra flotante de memoria a registro entero t4
    fmv.w.x ft0, t4                   # Transferir bits de t4 al registro flotante ft0
    fsub.s ft1, fa0, ft0              # ft1 = fa0 - ft0 (diferencia con valor esperado)

    fmv.x.w t4, ft1                   # Mover bits de la diferencia al registro entero t4
    la    t5, mascara_magnitud        # Cargar dirección de la máscara de magnitud
    lw    t5, 0(t5)                   # Cargar valor de la máscara 0x7FFFFFFF
    and   t4, t4, t5                  # Aplicar AND para obtener el valor absoluto
    fmv.w.x ft1, t4                   # Retornar magnitud absoluta a registro flotante ft1

    la    t5, constante_epsilon       # Cargar dirección del valor de tolerancia epsilon
    # REEMPLAZO 2 DE FLW: flw ft2, 0(t5) -> lw + fmv.w.x
    lw    t4, 0(t5)                   # Leer palabra flotante de epsilon a registro entero t4
    fmv.w.x ft2, t4                   # Transferir bits de t4 al registro flotante ft2
    flt.s t6, ft2, ft1                # t6 = 1 si 0.01 < |diferencia|
    bne   t6, zero, test_fallo        # Si la diferencia supera la tolerancia, prueba fallada

test_paso:
    addi  s2, s2, 1                   # Incrementar contador de pruebas exitosas
    j     siguiente_prueba            # Avanzar a la siguiente prueba

test_fallo:
    addi  s3, s3, 1                   # Incrementar contador de errores

siguiente_prueba:
    addi  s0, s0, 1                   # Incrementar índice de prueba actual
    addi  s4, s4, 20                  # Avanzar puntero de la tabla (20 bytes por entrada)
    j     bucle_pruebas               # Volver a ejecutar el bucle

fin_bateria_pruebas:
    la    a0, msg_resumen_hdr         # Cargar mensaje de cabecera de resumen
    jal   ra, ImprimirCadenaUART      # Imprimir por UART

    la    a0, msg_total_p             # Cargar etiqueta "Total de Pruebas:"
    jal   ra, ImprimirCadenaUART      # Imprimir por UART
    addi  a0, s1, 0                   # Cargar total de pruebas en a0
    jal   ra, ImprimirEnteroUART      # Imprimir número entero por UART

    la    a0, msg_exitosas_p          # Cargar etiqueta "Pruebas Exitosas:"
    jal   ra, ImprimirCadenaUART      # Imprimir por UART
    addi  a0, s2, 0                   # Cargar pruebas exitosas en a0
    jal   ra, ImprimirEnteroUART      # Imprimir número entero por UART

    la    a0, msg_errores_p           # Cargar etiqueta "Errores Detectados:"
    jal   ra, ImprimirCadenaUART      # Imprimir por UART
    addi  a0, s3, 0                   # Cargar errores en a0
    jal   ra, ImprimirEnteroUART      # Imprimir número entero por UART

    la    a0, msg_fin_resumen         # Cargar mensaje final del resumen
    jal   ra, ImprimirCadenaUART      # Imprimir por UART

    lw    ra, 0(sp)                   # Restaurar ra de la pila
    lw    s0, 4(sp)                   # Restaurar registro s0
    lw    s1, 8(sp)                   # Restaurar registro s1
    lw    s2, 12(sp)                  # Restaurar registro s2
    lw    s3, 16(sp)                  # Restaurar registro s3
    lw    s4, 20(sp)                  # Restaurar registro s4
    lw    s5, 24(sp)                  # Restaurar registro s5
    lw    s6, 28(sp)                  # Restaurar registro s6
    lw    s7, 32(sp)                  # Restaurar registro s7
    addi  sp, sp, 36                  # Liberar los 36 bytes reservamos de la pila
    jr    ra                          # Retornar de la función de batería de pruebas

#------------------------------------------------------------------------------
# IMPRIMIR ENTERO POR UART (Para números pequeños <= 99)
#------------------------------------------------------------------------------
ImprimirEnteroUART:
    addi  sp, sp, -16                 # Reservar 16 bytes en la pila
    sw    ra, 0(sp)                   # Guardar ra
    sw    s0, 4(sp)                   # Guardar s0
    sw    s1, 8(sp)                   # Guardar s1

    addi  s0, a0, 0                   # Copiar entero recibido a s0
    bne   s0, zero, conv_enteros_tabla# Si el número no es 0, pasar a descomponer

    addi  a0, zero, 48                # Cargar carácter ASCII '0'
    jal   ra, WriteUART               # Imprimir '0' por UART
    j     fin_imp_ent_uart            # Salir de la función

conv_enteros_tabla:
    addi  t0, zero, 10                # Cargar divisor base 10 en t0
    blt   s0, t0, solo_un_digito      # Si s0 < 10, solo consta de un dígito
    addi  s1, zero, 0                 # Inicializar contador de decenas en 0

contar_decenas:
    blt   s0, t0, fin_contar_dec      # Si s0 < 10, finalizar conteo de decenas
    sub   s0, s0, t0                  # Restar 10 a s0
    addi  s1, s1, 1                   # Incrementar contador de decenas
    j     contar_decenas              # Repetir bucle de restas sucesivas

fin_contar_dec:
    addi  a0, s1, 48                  # Convertir número de decenas a ASCII (+48)
    jal   ra, WriteUART               # Imprimir dígito de decenas por UART

solo_un_digito:
    addi  a0, s0, 48                  # Convertir número de unidades a ASCII (+48)
    jal   ra, WriteUART               # Imprimir dígito de unidades por UART

fin_imp_ent_uart:
    lw    ra, 0(sp)                   # Restaurar ra
    lw    s0, 4(sp)                   # Restaurar s0
    lw    s1, 8(sp)                   # Restaurar s1
    addi  sp, sp, 16                  # Liberar pila
    jr    ra                          # Retornar de la función

###############################################################################
# ASCII -> BCD (CON DETECCIÓN CORREGIDA DE UNDERFLOW)
###############################################################################
ascii_a_bcd:
    addi  t0, a1, 0                   # Cargar dirección base destino BCD en t0
    addi  t1, zero, 16                # Contador para 16 palabras de la estructura BCD

limpiar_bcd:
    sw    zero, 0(t0)                 # Limpiar palabra en BCD (escribir cero)
    addi  t0, t0, 4                   # Avanzar al siguiente offset de palabra
    addi  t1, t1, -1                  # Decrementar contador de palabras
    bne   t1, zero, limpiar_bcd       # Continuar limpiando hasta completar 16 palabras

    addi  t0, zero, 0                 # Inicializar signo por defecto en 0 (Positivo)
    lb    t1, 0(a0)                   # Leer primer carácter de la cadena ASCII
    addi  t2, zero, 45                # Cargar carácter ASCII del signo '-' (45)

    bne   t1, t2, contar_enteros      # Si no empieza por '-', ir a contar enteros
    addi  t0, zero, 1                 # Marcar signo como negativo (1)
    addi  a0, a0, 1                   # Avanzar puntero ASCII para ignorar el '-'

contar_enteros:
    sw    t0, 0(a1)                   # Guardar la palabra de signo en la palabra 0 del BCD

    addi  t0, a0, 0                   # Copiar puntero ASCII a t0
    addi  t1, zero, 0                 # Inicializar contador de dígitos enteros t1 = 0

contar_loop:
    lb    t2, 0(t0)                   # Leer carácter de la cadena
    beq   t2, zero, fin_contar        # Si se llega al fin de cadena '\0', terminar conteo

    addi  t3, zero, 46                # ASCII del carácter '.'
    beq   t2, t3, fin_contar          # Si se encuentra el punto decimal, terminar conteo

    addi  t3, zero, 48                # ASCII '0'
    blt   t2, t3, fin_contar          # Si el carácter es menor a '0', terminar conteo

    addi  t3, zero, 57                # ASCII '9'
    blt   t3, t2, fin_contar          # Si el carácter es mayor a '9', terminar conteo

    addi  t1, t1, 1                   # Incrementar contador de dígitos enteros
    addi  t0, t0, 1                   # Avanzar puntero del buffer ASCII
    jal   zero, contar_loop           # Repetir bucle de conteo

fin_contar:
    addi  t2, zero, 10                # Total de dígitos enteros reservados = 10
    sub   t2, t2, t1                  # Calcular posiciones vacías para alineación derecha
    addi  t3, zero, 0                 # Offset inicial en bytes = 0
    addi  t4, zero, 0                 # Contador para cálculo de offset = 0

multiplicar_offset:
    beq   t4, t2, fin_offset          # Si se completó el conteo de posiciones vacías, salir
    addi  t3, t3, 4                   # Sumar 4 bytes por cada palabra vacía
    addi  t4, t4, 1                   # Incrementar contador
    jal   zero, multiplicar_offset    # Repetir multiplicación por suma

fin_offset:
    addi  t2, t3, 4                   # Sumar 4 bytes del offset para saltar la palabra 0 de signo
    add   t0, a1, t2                  # t0 = dirección exacta donde inicia el primer dígito entero

escribir_enteros:
    beq   t1, zero, chequear_decimal  # Si no hay más dígitos enteros, pasar a decimales
    lb    t2, 0(a0)                   # Leer carácter del dígito en ASCII
    addi  t3, zero, 48                # Cargar '0' ASCII (48)
    sub   t2, t2, t3                  # t2 = ASCII - '0' (Convertir a valor entero)
    sw    t2, 0(t0)                   # Guardar el valor entero en el arreglo BCD
    addi  t0, t0, 4                   # Avanzar al siguiente espacio en BCD
    addi  a0, a0, 1                   # Avanzar en la cadena ASCII
    addi  t1, t1, -1                  # Decrementar contador de enteros pendientes
    jal   zero, escribir_enteros      # Repetir para el próximo dígito entero

chequear_decimal:
    lb    t2, 0(a0)                   # Leer carácter actual de la cadena
    addi  t3, zero, 46                # ASCII del punto '.' (46)
    bne   t2, t3, fin_ascii_bcd       # Si no hay punto decimal, terminar conversión BCD
    addi  a0, a0, 1                   # Avanzar puntero ASCII saltando el punto '.'

    addi  t0, a1, 44                  # Cargar offset de la palabra 11 en BCD (44 bytes)
    addi  t1, zero, 5                 # Límite de procesamiento de hasta 5 decimales

escribir_decimales:
    beq   t1, zero, chequear_resto_underflow # Si se procesaron 5 decimales, verificar dígitos sobrantes
    lb    t2, 0(a0)                   # Leer carácter ASCII decimal
    beq   t2, zero, fin_ascii_bcd     # Si se llega al fin de cadena, terminar

    addi  t3, zero, 48                # ASCII '0'
    blt   t2, t3, fin_ascii_bcd       # Si el carácter es menor a '0', terminar
    addi  t3, zero, 57                # ASCII '9'
    blt   t3, t2, fin_ascii_bcd       # Si el carácter es mayor a '9', terminar

    addi  t3, zero, 48                # Restablecer t3 a 48
    sub   t2, t2, t3                  # t2 = ASCII - '0'
    sw    t2, 0(t0)                   # Guardar dígito decimal en la posición BCD
    addi  t0, t0, 4                   # Avanzar puntero BCD
    addi  a0, a0, 1                   # Avanzar puntero ASCII
    addi  t1, t1, -1                  # Decrementar contador de decimales
    jal   zero, escribir_decimales    # Repetir para los demás dígitos decimales

chequear_resto_underflow:
buscar_nonzero_loop:
    lb    t2, 0(a0)                   # Leer carácter sobrante después del 5to decimal
    beq   t2, zero, fin_ascii_bcd     # Si finalizó la cadena sin más dígitos, no hay underflow

    addi  t3, zero, 49                # ASCII '1'
    blt   t2, t3, sig_caracter_und    # Si el carácter es menor a '1' (es '0'), continuar escaneo
    addi  t3, zero, 57                # ASCII '9'
    blt   t3, t2, sig_caracter_und    # Si el carácter es mayor a '9', continuar escaneo

    # Se detectó un dígito significativo > 0 recortado
    addi  t3, a1, 4                   # Apuntar a la palabra 1 (inicio de enteros en BCD)
    addi  t4, zero, 10                # Contador de 10 palabras enteras
chk_ent_loop:
    lw    t5, 0(t3)                   # Leer valor de la palabra entera
    bne   t5, zero, fin_ascii_bcd     # Si alguna palabra entera es > 0, el número es >= 1.0 (no underflow)
    addi  t3, t3, 4                   # Avanzar a la siguiente palabra
    addi  t4, t4, -1                  # Decrementar contador
    bne   t4, zero, chk_ent_loop      # Repetir para los 10 dígitos enteros

    addi  t3, a1, 44                  # Apuntar a la palabra 11 (inicio de decimales en BCD)
    addi  t4, zero, 5                 # Contador de 5 palabras decimales
chk_dec_loop:
    lw    t5, 0(t3)                   # Leer valor de la palabra decimal
    bne   t5, zero, fin_ascii_bcd     # Si alguna es > 0, es >= 0.00001 (no underflow)
    addi  t3, t3, 4                   # Avanzar a la siguiente palabra decimal
    addi  t4, t4, -1                  # Decrementar contador
    bne   t4, zero, chk_dec_loop      # Repetir para las 5 palabras decimales

    addi  t4, zero, 3                 # Asignar código de estado 3 (Underflow)
    sw    t4, 0(a1)                   # Escribir código 3 en la palabra de estado del BCD
    jr    ra                          # Retornar inmediatamente

sig_caracter_und:
    addi  a0, a0, 1                   # Avanzar al siguiente carácter
    jal   zero, buscar_nonzero_loop   # Continuar escaneo de underflow

fin_ascii_bcd:
    jr    ra                          # Retornar de la función ascii_a_bcd

###############################################################################
# BCD -> ASCII
###############################################################################
bcd_a_ascii:
    addi  sp, sp, -16                 # Reservar 16 bytes en la pila
    sw    ra, 0(sp)                   # Guardar ra
    sw    s0, 4(sp)                   # Guardar s0
    sw    s1, 8(sp)                   # Guardar s1
    sw    s2, 12(sp)                  # Guardar s2

    addi  s0, a0, 0                   # Copiar dirección base de la estructura BCD a s0
    lw    t0, 0(s0)                   # Leer palabra 0 (signo)

    beq   t0, zero, omitir_signo      # Si el signo es 0 (+), omitir impresión del signo
    addi  a0, zero, 45                # Cargar carácter ASCII del signo '-' (45)
    jal   ra, WriteUART               # Imprimir '-' por UART

omitir_signo:
    addi  s1, s0, 4                   # Apuntar a la palabra 1 (primer entero en BCD)
    addi  s2, zero, 10                # Contador para 10 dígitos enteros

bucle_imp_ent:
    lw    a0, 0(s1)                   # Leer valor entero de la palabra actual
    addi  a0, a0, 48                  # Convertir valor entero a carácter ASCII (+48)
    jal   ra, WriteUART               # Imprimir el dígito por UART
    addi  s1, s1, 4                   # Avanzar a la siguiente palabra en BCD
    addi  s2, s2, -1                  # Decrementar contador
    bne   s2, zero, bucle_imp_ent     # Repetir para los 10 dígitos enteros

    addi  a0, zero, 46                # Cargar carácter ASCII del punto decimal '.' (46)
    jal   ra, WriteUART               # Imprimir '.' por UART

    addi  s2, zero, 5                 # Contador para 5 dígitos decimales

bucle_imp_dec:
    lw    a0, 0(s1)                   # Leer valor decimal de la palabra actual
    addi  a0, a0, 48                  # Convertir valor a carácter ASCII (+48)
    jal   ra, WriteUART               # Imprimir el dígito decimal por UART
    addi  s1, s1, 4                   # Avanzar a la siguiente palabra en BCD
    addi  s2, s2, -1                  # Decrementar contador
    bne   s2, zero, bucle_imp_dec     # Repetir para los 5 dígitos decimales

    lw    ra, 0(sp)                   # Restaurar ra
    lw    s0, 4(sp)                   # Restaurar s0
    lw    s1, 8(sp)                   # Restaurar s1
    lw    s2, 12(sp)                  # Restaurar s2
    addi  sp, sp, 16                  # Liberar pila
    jr    ra                          # Retornar de la función bcd_a_ascii

###############################################################################
# BCD -> FLOAT
###############################################################################
bcd_a_float:
    lw    t0, 0(a0)                   # Cargar signo/estado desde palabra 0 (0: +, 1: -)
    addi  a0, a0, 4                   # Apuntar a la palabra 1 (primer entero)

    fcvt.s.w fa0, zero                # Inicializar fa0 = 0.0 (Acumulador flotante)

    la    t1, potencias10_10dig       # Cargar dirección de la tabla de potencias enteras
    addi  t3, zero, 10                # Contador de 10 dígitos enteros

bucle_entero:
    beq   t3, zero, fin_entero        # Si termina las 10 iteraciones, pasar a decimales
    lw    t4, 0(a0)                   # Leer el dígito entero de BCD
    beq   t4, zero, sig_digito_entero # Si el dígito es 0, saltar cálculos

    fcvt.s.w ft0, t4                  # Convertir dígito entero a float en ft0
    lw    t5, 0(t1)                   # Cargar potencia de 10 desde la tabla en memoria
    fcvt.s.w ft1, t5                  # Convertir potencia a float en ft1
    fmul.s ft0, ft0, ft1              # ft0 = dígito * potencia
    fadd.s fa0, fa0, ft0              # Acumular resultado en fa0

sig_digito_entero:
    addi  a0, a0, 4                   # Avanzar puntero de la estructura BCD
    addi  t1, t1, 4                   # Avanzar puntero de la tabla de potencias
    addi  t3, t3, -1                  # Decrementar contador
    j     bucle_entero                # Repetir bucle entero

fin_entero:
    fcvt.s.w ft3, zero                # Inicializar acumulador decimal ft3 = 0.0
    la    t1, potencias10_5dig        # Cargar dirección de la tabla de potencias decimales
    addi  t3, zero, 5                 # Contador de 5 dígitos decimales

bucle_decimal:
    beq   t3, zero, fin_decimal       # Si termina los 5 dígitos, salir del bucle
    lw    t4, 0(a0)                   # Leer dígito decimal de BCD
    beq   t4, zero, sig_digito_decimal# Si el dígito es 0, saltar cálculos

    fcvt.s.w ft0, t4                  # Convertir dígito decimal a float en ft0
    lw    t5, 0(t1)                   # Cargar potencia decimal desde la tabla
    fcvt.s.w ft1, t5                  # Convertir potencia a float en ft1
    fmul.s ft0, ft0, ft1              # ft0 = dígito * potencia
    fadd.s ft3, ft3, ft0              # Acumular en ft3

sig_digito_decimal:
    addi  a0, a0, 4                   # Avanzar puntero BCD
    addi  t1, t1, 4                   # Avanzar puntero de potencias
    addi  t3, t3, -1                  # Decrementar contador
    j     bucle_decimal               # Repetir bucle decimal

fin_decimal:
    la    t1, constante_100000        # Cargar dirección de la constante 100000.0
    # REEMPLAZO 3 DE FLW: flw ft2, 0(t1) -> lw + fmv.w.x
    lw    t2, 0(t1)                   # Leer los 32 bits de 100000.0 a entero t2
    fmv.w.x ft2, t2                   # Transferir bits de t2 a registro flotante ft2
    fdiv.s ft3, ft3, ft2              # Escalar la parte decimal acumulada: ft3 / 100000.0
    fadd.s fa0, fa0, ft3              # Sumar parte entera + parte decimal: fa0 = fa0 + ft3

    beq   t0, zero, fin_bcd2float     # Si el signo es 0 (+), finalizar
    la    t1, menos_un_float          # Cargar dirección de la constante -1.0
    # REEMPLAZO 4 DE FLW: flw ft2, 0(t1) -> lw + fmv.w.x
    lw    t2, 0(t1)                   # Leer los 32 bits de -1.0 a entero t2
    fmv.w.x ft2, t2                   # Transferir bits de t2 a registro flotante ft2
    fmul.s fa0, fa0, ft2              # Aplicar signo negativo: fa0 = fa0 * (-1.0)

fin_bcd2float:
    jr    ra                          # Retornar de la función bcd_a_float

###############################################################################
# FLOAT -> BCD (VALIDACIÓN DE OVERFLOW Y UNDERFLOW EN RESULTADOS)
###############################################################################
float_a_bcd:
    fmv.x.w t0, fa0                   # Extraer representación de bits de fa0 al registro entero t0
    la    t1, mascara_exponente       # Cargar dirección de la máscara del exponente IEEE-754
    lw    t1, 0(t1)                   # Leer máscara 0x7F800000
    and   t2, t0, t1                  # Filtrar los bits del exponente
    beq   t2, t1, caso_error_float2bcd# Si el exponente tiene todos 1s (NaN / Infinito), ir a error

    la    t1, mascara_magnitud        # Cargar dirección de la máscara de magnitud
    lw    t1, 0(t1)                   # Leer máscara 0x7FFFFFFF
    and   t3, t0, t1                  # Filtrar magnitud (ignorar bit de signo)
    beq   t3, zero, caso_cero_float2bcd # Si la magnitud es exactamente 0.0, tratar caso cero

    la    t4, limite_underflow        # Cargar dirección del valor límite de Underflow
    lw    t4, 0(t4)                   # Leer valor límite IEEE-754 (0.000005)
    blt   t3, t4, caso_underflow_float2bcd # Si magnitud < 0.000005, ir a underflow

    la    t4, limite_overflow         # Cargar dirección del valor límite de Overflow
    lw    t4, 0(t4)                   # Leer límite máximo permitido
    bgeu  t3, t4, caso_error_float2bcd# Si magnitud >= límite overflow, ir a error

    la    t1, mascara_signo           # Cargar dirección de máscara de signo
    lw    t1, 0(t1)                   # Leer máscara 0x80000000
    and   t1, t0, t1                  # Filtrar bit de signo
    beq   t1, zero, signo_positivo    # Si el bit de signo es 0, ir a signo_positivo
    addi  t1, zero, 1                 # Si es 1, guardar código 1 (negativo)

signo_positivo:
    sw    t1, 0(a0)                   # Guardar código de signo en la palabra 0 de BCD

    fmv.x.w t0, fa0                   # Extraer los bits del flotante fa0 a t0
    la    t1, mascara_magnitud        # Cargar máscara 0x7FFFFFFF
    lw    t1, 0(t1)                   # Leer la máscara
    and   t0, t0, t1                  # Eliminar bit de signo
    fmv.w.x ft0, t0                   # Mover la magnitud absoluta al registro flotante ft0

    fcvt.w.s t2, ft0, rtz             # Convertir float ft0 a entero truncado t2 (parte entera)
    fcvt.s.w ft1, t2                  # Convertir entero t2 de vuelta a float ft1
    fsub.s ft2, ft0, ft1              # ft2 = ft0 - ft1 (obtener parte decimal pura < 1.0)

    la    t1, constante_100000        # Cargar dirección de constante 100000.0
    # REEMPLAZO 5 DE FLW: flw ft3, 0(t1) -> lw + fmv.w.x
    lw    t4, 0(t1)                   # Leer los 32 bits de 100000.0 a entero t4
    fmv.w.x ft3, t4                   # Transferir bits de t4 a registro flotante ft3
    fmul.s ft2, ft2, ft3              # Escalar decimales: ft2 = ft2 * 100000.0
    fcvt.w.s a3, ft2, rne             # Redondear y convertir decimales escalados a entero en a3

    addi  a1, a0, 4                   # a1 = puntero a palabra 1 de BCD (enteros)
    addi  a2, t2, 0                   # a2 = parte entera a descomponer
    la    t1, potencias10_10dig       # Cargar dirección de la tabla de potencias enteras
    addi  t3, zero, 10                # Contador de 10 dígitos enteros

desc_entero_loop:
    beq   t3, zero, fin_desc_entero   # Si completó las 10 palabras enteras, salir
    lw    t5, 0(t1)                   # Cargar potencia de 10 actual
    addi  t4, zero, 0                 # Inicializar contador de restas (dígito BCD) en 0

restas_entero_loop:
    blt   a2, t5, fin_restas_entero   # Si el residuo a2 es menor que la potencia, salir
    sub   a2, a2, t5                  # Restar potencia al valor acumulado
    addi  t4, t4, 1                   # Incrementar dígito
    jal   zero, restas_entero_loop    # Repetir restas sucesivas

fin_restas_entero:
    sw    t4, 0(a1)                   # Guardar dígito entero calculado en BCD
    addi  a1, a1, 4                   # Avanzar puntero BCD
    addi  t1, t1, 4                   # Avanzar puntero de la tabla
    addi  t3, t3, -1                  # Decrementar contador
    jal   zero, desc_entero_loop      # Repetir descomposición para el siguiente dígito

fin_desc_entero:
    addi  a1, a0, 44                  # a1 = puntero a palabra 11 de BCD (decimales)
    addi  a2, a3, 0                   # a2 = parte decimal escalada a descomponer
    la    t1, potencias10_5dig        # Cargar dirección de la tabla de potencias decimales
    addi  t3, zero, 5                 # Contador de 5 dígitos decimales

desc_decimal_loop:
    beq   t3, zero, fin_desc_decimal  # Si completó las 5 palabras decimales, salir
    lw    t5, 0(t1)                   # Cargar potencia decimal actual
    addi  t4, zero, 0                 # Inicializar dígito en 0

restas_decimal_loop:
    blt   a2, t5, fin_restas_decimal  # Si a2 < potencia, salir
    sub   a2, a2, t5                  # Restar potencia
    addi  t4, t4, 1                   # Incrementar dígito
    jal   zero, restas_decimal_loop   # Repetir restas sucesivas

fin_restas_decimal:
    sw    t4, 0(a1)                   # Guardar dígito decimal calculado en BCD
    addi  a1, a1, 4                   # Avanzar puntero BCD
    addi  t1, t1, 4                   # Avanzar puntero de la tabla
    addi  t3, t3, -1                  # Decrementar contador
    jal   zero, desc_decimal_loop     # Repetir para el siguiente dígito decimal

fin_desc_decimal:
    jr    ra                          # Retornar de la función float_a_bcd

caso_cero_float2bcd:
    fmv.x.w t0, fa0                   # Copiar bits de fa0 al entero t0
    la    t1, mascara_signo           # Cargar dirección de la máscara de signo
    lw    t1, 0(t1)                   # Leer máscara 0x80000000
    and   t1, t0, t1                  # Extraer el bit de signo
    beq   t1, zero, cero_positivo     # Si signo es 0 (+), ir a cero_positivo
    addi  t1, zero, 1                 # Guardar 1 para indicar -0.0

cero_positivo:
    sw    t1, 0(a0)                   # Guardar signo en palabra 0 de BCD
    jal   zero, limpiar_digitos_bcd   # Ir a limpiar las 15 palabras de dígitos BCD

caso_error_float2bcd:
    addi  t1, zero, 2                 # Cargar código 2 = Error/Overflow
    sw    t1, 0(a0)                   # Guardar código de estado en palabra 0 de BCD
    jal   zero, limpiar_digitos_bcd   # Ir a limpiar dígitos BCD

caso_underflow_float2bcd:
    addi  t1, zero, 3                 # Cargar código 3 = Underflow
    sw    t1, 0(a0)                   # Guardar código de estado en palabra 0 de BCD

limpiar_digitos_bcd:
    addi  a1, a0, 4                   # Puntero a la palabra 1 (primer dígito entero)
    addi  t2, zero, 15                # Contador de 15 palabras de dígitos a limpiar

bucle_limpiar:
    beq   t2, zero, ret_float2bcd     # Si se limpiaron las 15 palabras, terminar
    sw    zero, 0(a1)                 # Escribir cero en la palabra actual
    addi  a1, a1, 4                   # Avanzar puntero BCD
    addi  t2, t2, -1                  # Decrementar contador
    jal   zero, bucle_limpiar         # Repetir bucle de limpieza

ret_float2bcd:
    jr    ra                          # Retornar de la función

###############################################################################
# COMUNICACIÓN UART
###############################################################################
WriteUART:
    la    t0, WriteAddrUART           # Cargar dirección de la variable WriteAddrUART
    lw    t0, 0(t0)                   # Leer dirección del puerto UART

esperar_WSPACE:
    lw    t1, 4(t0)                   # Leer registro de estado/control del puerto UART
    la    t2, mascara_WSPACE          # Cargar dirección de la máscara WSPACE
    lw    t2, 0(t2)                   # Leer máscara 0xFFFF0000
    and   t1, t1, t2                  # Filtrar espacio en buffer
    beq   t1, zero, esperar_WSPACE    # Esperar mientras no haya espacio de escritura disponible

    sw    a0, 0(t0)                   # Enviar el carácter cargado en a0 al puerto UART
    jr    ra                          # Retornar

ReadUART:
    la    t0, ReadAddrUART            # Cargar dirección de la variable ReadAddrUART
    lw    t0, 0(t0)                   # Leer dirección del puerto UART
    lw    a0, 0(t0)                   # Leer dato recibido desde UART al registro a0
    jr    ra                          # Retornar

DELChar:
    addi  sp, sp, -4                  # Reservar 4 bytes en pila
    sw    ra, 0(sp)                   # Guardar ra

    addi  a0, zero, 8                 # Cargar código ASCII Backspace (8)
    jal   ra, WriteUART               # Enviar Backspace a la terminal UART
    addi  a0, zero, 32                # Cargar código ASCII espacio ' ' (32)
    jal   ra, WriteUART               # Sobrescribir carácter borrado con un espacio
    addi  a0, zero, 8                 # Cargar código ASCII Backspace (8)
    jal   ra, WriteUART               # Regresar cursor una posición hacia atrás

    lw    ra, 0(sp)                   # Restaurar ra
    addi  sp, sp, 4                   # Liberar pila
    jr    ra                          # Retornar

LeerLineaUART:
    addi  sp, sp, -12                 # Reservar 12 bytes en pila
    sw    ra, 0(sp)                   # Guardar ra
    sw    s0, 4(sp)                   # Guardar s0
    sw    s1, 8(sp)                   # Guardar s1

    addi  s0, a0, 0                   # s0 = puntero móvil dentro del buffer de entrada
    addi  s1, a0, 0                   # s1 = puntero al inicio del buffer de entrada

bucle_lectura_linea:
    jal   ra, ReadUART                # Leer registro UART
    la    t0, OchoMil                 # Cargar dirección de la máscara OchoMil
    lw    t0, 0(t0)                   # Leer constante 0x8000
    and   t0, t0, a0                  # Verificar si el dato leído es válido
    beq   t0, zero, bucle_lectura_linea # Si no hay carácter válido, continuar esperando

    andi  a0, a0, 0xFF                # Extraer los 8 bits útiles del carácter ASCII

    addi  t0, zero, 13                # ASCII de Enter / Return CR (13)
    beq   a0, t0, fin_lectura_linea   # Si se presionó Enter, finalizar lectura

    addi  t0, zero, 10                # ASCII de Line Feed LF (10)
    beq   a0, t0, fin_lectura_linea   # Si es LF, finalizar lectura

    addi  t0, zero, 127               # ASCII de tecla DEL (127)
    beq   a0, t0, procesar_borrado    # Si es DEL, procesar el borrado del carácter

    addi  t0, zero, 8                 # ASCII de Backspace (8)
    beq   a0, t0, procesar_borrado    # Si es Backspace, procesar borrado

    sb    a0, 0(s0)                   # Almacenar carácter en el buffer de entrada
    addi  s0, s0, 1                   # Incrementar puntero del buffer
    jal   ra, WriteUART               # Hacer eco del carácter en la terminal UART
    jal   zero, bucle_lectura_linea   # Continuar leyendo caracteres

procesar_borrado:
    beq   s0, s1, bucle_lectura_linea # Si el buffer está vacío, ignorar borrado
    addi  s0, s0, -1                  # Retroceder el puntero del buffer una posición
    jal   ra, DELChar                 # Borrar visualmente el carácter en pantalla
    jal   zero, bucle_lectura_linea   # Volver al bucle de lectura

fin_lectura_linea:
    sb    zero, 0(s0)                 # Insertar carácter terminador nulo '\0' al final de la cadena
    lw    ra, 0(sp)                   # Restaurar ra
    lw    s0, 4(sp)                   # Restaurar s0
    lw    s1, 8(sp)                   # Restaurar s1
    addi  sp, sp, 12                  # Liberar pila
    jr    ra                          # Retornar

ImprimirCadenaUART:
    addi  sp, sp, -8                  # Reservar 8 bytes en pila
    sw    ra, 0(sp)                   # Guardar ra
    sw    s0, 4(sp)                   # Guardar s0

    addi  s0, a0, 0                   # Copiar dirección de la cadena de texto a s0

bucle_imp_cadena:
    lb    a0, 0(s0)                   # Leer carácter de la cadena
    beq   a0, zero, fin_imp_cadena    # Si se alcanza el terminador nulo '\0', finalizar
    jal   ra, WriteUART               # Imprimir carácter por UART
    addi  s0, s0, 1                   # Avanzar al siguiente carácter
    jal   zero, bucle_imp_cadena      # Repetir bucle

fin_imp_cadena:
    lw    ra, 0(sp)                   # Restaurar ra
    lw    s0, 4(sp)                   # Restaurar s0
    addi  sp, sp, 8                   # Liberar pila
    jr    ra                          # Retornar

BuscarOperador:
    addi  t0, a0, 0                   # Copiar dirección de la cadena a t0
    lb    t1, 0(t0)                   # Leer el primer carácter de la cadena
    addi  t2, zero, 45                # ASCII del signo '-' (45)

    bne   t1, t2, bucle_buscar_op     # Si no empieza por '-', iniciar búsqueda
    addi  t0, t0, 1                   # Omitir el signo '-' si pertenece al primer número

bucle_buscar_op:
    lb    t1, 0(t0)                   # Leer carácter actual
    beq   t1, zero, no_encontrado_op  # Si se llega al final sin encontrar operador, salir

    addi  t2, zero, 43                # ASCII de '+' (43)
    beq   t1, t2, op_encontrado       # Si t1 == '+', operador encontrado

    addi  t2, zero, 45                # ASCII de '-' (45)
    beq   t1, t2, op_encontrado       # Si t1 == '-', operador encontrado

    addi  t2, zero, 42                # ASCII de '*' (42)
    beq   t1, t2, op_encontrado       # Si t1 == '*', operador encontrado

    addi  t2, zero, 47                # ASCII de '/' (47)
    beq   t1, t2, op_encontrado       # Si t1 == '/', operador encontrado

    addi  t0, t0, 1                   # Avanzar al siguiente carácter
    jal   zero, bucle_buscar_op       # Continuar bucle de búsqueda

op_encontrado:
    sb    zero, 0(t0)                 # Colocar '\0' para dividir la cadena en el primer operando
    addi  a0, t1, 0                   # Retornar el carácter del operador en a0
    addi  a1, t0, 1                   # Retornar dirección del inicio del segundo operando en a1
    jr    ra                          # Retornar

no_encontrado_op:
    addi  a0, zero, 0                 # Retornar 0 indicando que no se halló operador
    addi  a1, zero, 0                 # Retornar dirección nula en a1
    jr    ra                          # Retornar

