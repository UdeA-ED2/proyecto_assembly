###############################################################################
# CALCULADORA - 10 DÍGITOS ENTEROS (32-bit MAX) + 5 DECIMALES
###############################################################################
.global _start
_start:

main:
    la    sp, tope_stack

ciclo_principal:
    la    a0, msg_prompt
    jal   ra, ImprimirCadenaUART

    la    a0, buffer_entrada
    jal   ra, LeerLineaUART

    la    a0, buffer_entrada
    jal   ra, BuscarOperador
    mv    s0, a0                 
    mv    s1, a1                 

    beqz  s0, error_operacion

    # --- OPERANDO 1 ---
    la    a0, buffer_entrada
    la    a1, bcd_op1
    jal   ra, ascii_a_bcd        
    
    la    a0, bcd_op1
    jal   ra, bcd_a_float        
    fmv.s fs0, fa0               

    # --- OPERANDO 2 ---
    mv    a0, s1
    la    a1, bcd_op2
    jal   ra, ascii_a_bcd        
    
    la    a0, bcd_op2
    jal   ra, bcd_a_float        
    fmv.s fs1, fa0               

    # --- OPERACIÓN FPU ---
    li    t0, '+'
    beq   s0, t0, op_suma
    li    t0, '-'
    beq   s0, t0, op_resta
    li    t0, '*'
    beq   s0, t0, op_mult
    li    t0, '/'
    beq   s0, t0, op_div
    j     error_operacion

op_suma:
    fadd.s fa0, fs0, fs1
    j      procesar_resultado
op_resta:
    fsub.s fa0, fs0, fs1
    j      procesar_resultado
op_mult:
    fmul.s fa0, fs0, fs1
    j      procesar_resultado
op_div:
    fdiv.s fa0, fs0, fs1
    j      procesar_resultado

procesar_resultado:
    la    a0, msg_igual
    jal   ra, ImprimirCadenaUART

    la    a0, bcd_res
    jal   ra, float_a_bcd        

    la    a0, bcd_res
    jal   ra, bcd_a_ascii        
    j     ciclo_principal

error_operacion:
    la    a0, msg_error
    jal   ra, ImprimirCadenaUART
    j     ciclo_principal

###############################################################################
# SUBRUTINAS BCD <-> ASCII 
###############################################################################
ascii_a_bcd:
    mv    t0, a1
    li    t1, 16
limpiar_bcd:
    sw    zero, 0(t0)
    addi  t0, t0, 4
    addi  t1, t1, -1
    bnez  t1, limpiar_bcd

    li    t0, 0                  
    lb    t1, 0(a0)
    li    t2, '-'
    bne   t1, t2, contar_enteros
    li    t0, 1                  
    addi  a0, a0, 1              
contar_enteros:
    sw    t0, 0(a1)              

    mv    t0, a0
    li    t1, 0                  
contar_loop:
    lb    t2, 0(t0)
    beqz  t2, fin_contar         
    li    t3, '.'
    beq   t2, t3, fin_contar     
    li    t3, '0'
    blt   t2, t3, fin_contar
    li    t3, '9'
    bgt   t2, t3, fin_contar
    addi  t1, t1, 1
    addi  t0, t0, 1
    j     contar_loop
fin_contar:
    
    li    t2, 10
    sub   t2, t2, t1
    slli  t2, t2, 2
    addi  t2, t2, 4
    add   t0, a1, t2             

escribir_enteros:
    beqz  t1, chequear_decimal
    lb    t2, 0(a0)
    li    t3, '0'
    sub   t2, t2, t3             
    sw    t2, 0(t0)              
    addi  t0, t0, 4
    addi  a0, a0, 1
    addi  t1, t1, -1
    j     escribir_enteros

chequear_decimal:
    lb    t2, 0(a0)
    li    t3, '.'
    bne   t2, t3, fin_ascii_bcd  
    addi  a0, a0, 1              
    
    addi  t0, a1, 44             
    li    t1, 5                  
escribir_decimales:
    beqz  t1, fin_ascii_bcd      
    lb    t2, 0(a0)
    beqz  t2, fin_ascii_bcd      
    li    t3, '0'
    blt   t2, t3, fin_ascii_bcd  
    li    t3, '9'
    bgt   t2, t3, fin_ascii_bcd
    
    li    t3, '0'
    sub   t2, t2, t3             
    sw    t2, 0(t0)              
    addi  t0, t0, 4
    addi  a0, a0, 1
    addi  t1, t1, -1
    j     escribir_decimales
fin_ascii_bcd:
    ret

bcd_a_ascii:
    addi  sp, sp, -16
    sw    ra, 0(sp)
    sw    s0, 4(sp)
    sw    s1, 8(sp)
    sw    s2, 12(sp)
    mv    s0, a0

    lw    t0, 0(s0)
    beqz  t0, omitir_signo
    li    a0, '-'
    jal   ra, WriteUART          
omitir_signo:

    addi  s1, s0, 4              
    li    s2, 10
bucle_imp_ent:
    lw    a0, 0(s1)
    addi  a0, a0, '0'            
    jal   ra, WriteUART          
    addi  s1, s1, 4
    addi  s2, s2, -1
    bnez  s2, bucle_imp_ent

    li    a0, '.'
    jal   ra, WriteUART          

    li    s2, 5
bucle_imp_dec:
    lw    a0, 0(s1)
    addi  a0, a0, '0'
    jal   ra, WriteUART          
    addi  s1, s1, 4
    addi  s2, s2, -1
    bnez  s2, bucle_imp_dec

    lw    ra, 0(sp)
    lw    s0, 4(sp)
    lw    s1, 8(sp)
    lw    s2, 12(sp)
    addi  sp, sp, 16
    ret

###############################################################################
# SUBRUTINAS DE CONVERSIÓN
###############################################################################
bcd_a_float:
    lw   t0, 0(a0)                  
    addi a0, a0, 4                  
    la   t1, potencias10_10dig      
    addi t2, zero, 0                
    addi t3, zero, 10               
bucle_entero:
    beq  t3, zero, fin_entero
    lw   t4, 0(a0)                  
    lw   t5, 0(t1)                  
    addi t6, zero, 0
mult_entero:
    beq  t4, zero, fin_mult_entero
    add  t6, t6, t5
    addi t4, t4, -1
    j    mult_entero
fin_mult_entero:
    add  t2, t2, t6
    addi a0, a0, 4
    addi t1, t1, 4
    addi t3, t3, -1
    j    bucle_entero
fin_entero:
    la   t1, potencias10_5dig
    addi t3, zero, 5
    addi a3, zero, 0                
bucle_decimal:
    beq  t3, zero, fin_decimal
    lw   t4, 0(a0)
    lw   t5, 0(t1)
    addi t6, zero, 0
mult_decimal:
    beq  t4, zero, fin_mult_decimal
    add  t6, t6, t5
    addi t4, t4, -1
    j    mult_decimal
fin_mult_decimal:
    add  a3, a3, t6
    addi a0, a0, 4
    addi t1, t1, 4
    addi t3, t3, -1
    j    bucle_decimal
fin_decimal:
    fcvt.s.w ft0, t2                
    fcvt.s.w ft1, a3                
    la   t1, constante_100000
    flw  ft2, 0(t1)                 
    fdiv.s ft1, ft1, ft2            
    fadd.s fa0, ft0, ft1            
    beq  t0, zero, fin_bcd2float
    fmv.x.w t1, fa0
    lui  t2, 0x80000                
    or   t1, t1, t2
    fmv.w.x fa0, t1
fin_bcd2float:
    ret

float_a_bcd:
    fmv.x.w t0, fa0                 
    lui  t1, 0x7F800                
    and  t2, t0, t1                 
    beq  t2, t1, caso_error_float2bcd
    slli t3, t0, 1                  
    srli t3, t3, 1                  
    beq  t3, zero, caso_cero_float2bcd
    
    lui  t4, 0x36A00
    blt  t3, t4, caso_underflow_float2bcd
    
    # ---------------------------------------------------------
    # AQUI ESTA LA CORRECCIÓN: Límite expandido a 2.147x10^9
    # ---------------------------------------------------------
    lui  t4, 0x4F000
    bgt  t3, t4, caso_error_float2bcd
    
    srli t1, t0, 31                 
    sw   t1, 0(a0)                  
    fabs.s ft0, fa0
    fcvt.w.s t2, ft0, rtz           
    fcvt.s.w ft1, t2                
    fsub.s   ft2, ft0, ft1          
    la   t1, constante_100000
    flw  ft3, 0(t1)
    fmul.s ft2, ft2, ft3            
    fcvt.w.s a3, ft2, rne           
    addi a1, a0, 4                  
    add  a2, t2, zero               
    la   t1, potencias10_10dig      
    addi t3, zero, 10               
desc_entero_loop:
    beq  t3, zero, fin_desc_entero
    lw   t5, 0(t1)
    addi t4, zero, 0
restas_entero_loop:
    blt  a2, t5, fin_restas_entero
    sub  a2, a2, t5
    addi t4, t4, 1
    j    restas_entero_loop
fin_restas_entero:
    sw   t4, 0(a1)
    addi a1, a1, 4
    addi t1, t1, 4
    addi t3, t3, -1
    j    desc_entero_loop
fin_desc_entero:
    addi a1, a0, 44                 
    add  a2, a3, zero               
    la   t1, potencias10_5dig
    addi t3, zero, 5
desc_decimal_loop:
    beq  t3, zero, fin_desc_decimal
    lw   t5, 0(t1)
    addi t4, zero, 0
restas_decimal_loop:
    blt  a2, t5, fin_restas_decimal
    sub  a2, a2, t5
    addi t4, t4, 1
    j    restas_decimal_loop
fin_restas_decimal:
    sw   t4, 0(a1)
    addi a1, a1, 4
    addi t1, t1, 4
    addi t3, t3, -1
    j    desc_decimal_loop
fin_desc_decimal:
    ret                             

caso_cero_float2bcd:
    srli t1, t0, 31                 
    sw   t1, 0(a0)
    j    limpiar_digitos_bcd
caso_error_float2bcd:
    addi t1, zero, 2                
    sw   t1, 0(a0)
    j    limpiar_digitos_bcd
caso_underflow_float2bcd:
    addi t1, zero, 3                
    sw   t1, 0(a0)
limpiar_digitos_bcd:
    addi a1, a0, 4
    addi t2, zero, 15               
bucle_limpiar:
    beq  t2, zero, ret_float2bcd
    sw   zero, 0(a1)
    addi a1, a1, 4
    addi t2, t2, -1
    j    bucle_limpiar
ret_float2bcd:
    ret                             

###############################################################################
# SUBRUTINAS DE LECTURA/ESCRITURA UART
###############################################################################
WriteUART:
    la   t0, WriteAddrUART
    lw   t0, 0(t0)
    sw   a0, 0(t0)
    jr   ra

ReadUART:
    la   t0, ReadAddrUART
    lw   t0, 0(t0)
    lw   a0, 0(t0)
    jr   ra

DELChar:
    addi sp, sp, -4
    sw   ra, 0(sp)
    addi a0, zero, 0x8 
    jal  ra, WriteUART
    addi a0, zero, 0x20 
    jal  ra, WriteUART
    addi a0, zero, 0x8 
    jal  ra, WriteUART
    lw   ra, 0(sp)
    addi sp, sp, 4
    jr   ra

LeerLineaUART:
    addi  sp, sp, -12
    sw    ra, 0(sp)
    sw    s0, 4(sp)
    sw    s1, 8(sp)
    mv    s0, a0
    mv    s1, a0
bucle_lectura_linea:
    jal   ra, ReadUART
    la    t0, OchoMil
    lw    t0, 0(t0)
    and   t0, t0, a0
    beq   t0, zero, bucle_lectura_linea
    andi  a0, a0, 0xFF
    li    t0, 13
    beq   a0, t0, fin_lectura_linea
    li    t0, 10
    beq   a0, t0, fin_lectura_linea
    li    t0, 0x7F
    beq   a0, t0, procesar_borrado
    li    t0, 0x08
    beq   a0, t0, procesar_borrado
    sb    a0, 0(s0)
    addi  s0, s0, 1
    jal   ra, WriteUART
    j     bucle_lectura_linea
procesar_borrado:
    beq   s0, s1, bucle_lectura_linea
    addi  s0, s0, -1
    jal   ra, DELChar
    j     bucle_lectura_linea
fin_lectura_linea:
    sb    zero, 0(s0)
    lw    ra, 0(sp)
    lw    s0, 4(sp)
    lw    s1, 8(sp)
    addi  sp, sp, 12
    jr    ra

ImprimirCadenaUART:
    addi  sp, sp, -8
    sw    ra, 0(sp)
    sw    s0, 4(sp)
    mv    s0, a0
bucle_imp_cadena:
    lb    a0, 0(s0)
    beqz  a0, fin_imp_cadena
    jal   ra, WriteUART
    addi  s0, s0, 1
    j     bucle_imp_cadena
fin_imp_cadena:
    lw    ra, 0(sp)
    lw    s0, 4(sp)
    addi  sp, sp, 8
    jr    ra

BuscarOperador:
    mv    t0, a0
    lb    t1, 0(t0)
    li    t2, '-'
    bne   t1, t2, bucle_buscar_op
    addi  t0, t0, 1              
bucle_buscar_op:
    lb    t1, 0(t0)
    beqz  t1, no_encontrado_op
    li    t2, '+'
    beq   t1, t2, op_encontrado
    li    t2, '-'
    beq   t1, t2, op_encontrado
    li    t2, '*'
    beq   t1, t2, op_encontrado
    li    t2, '/'
    beq   t1, t2, op_encontrado
    addi  t0, t0, 1
    j     bucle_buscar_op
op_encontrado:
    sb    zero, 0(t0)            
    mv    a0, t1                 
    addi  a1, t0, 1              
    ret
no_encontrado_op:
    mv    a0, zero
    mv    a1, zero
    ret

###############################################################################
# DATOS
###############################################################################
.data
msg_prompt:       .string "\r\n> "
msg_igual:        .string " = "
msg_error:        .string "\r\n[ERROR] Operacion invalida!\r\n"

.align 2          

buffer_entrada:   .space 64
bcd_op1:          .space 64
bcd_op2:          .space 64
bcd_res:          .space 64

constante_100000: .float 100000.0

potencias10_10dig:.word 1000000000, 100000000, 10000000, 1000000, 100000, 10000, 1000, 100, 10, 1
potencias10_5dig: .word 10000, 1000, 100, 10, 1

OchoMil:          .word 0x8000
ReadAddrUART:     .dc.l 0xff201000
WriteAddrUART:    .dc.l 0xff201000

reserva_stack:    .space 160
tope_stack:
