###############################################################################
# CALCULADORA EN ASSEMBLER RISC-V CON BATERÍA DE PRUEBAS AUTOMÁTICA
# (ENTREGA 3 - ORGANIZACIÓN DE COMPUTADORES)
#
# Formato BCD expandido:
#   Palabra 0     -> Signo / Código de Estado (0: + normal, 1: - normal, 2: Error/Overflow, 3: Underflow, 4: Div/0)
#   Palabras 1-10 -> 10 dígitos enteros
#   Palabras 11-15-> 5 dígitos decimales
#
# Total: 16 palabras * 4 bytes = 64 bytes
###############################################################################

.global _start

_start:

main:
    # 1. INICIALIZAR LA PILA AL FINAL DE .DATA
    la    sp, tope_stack             # SP apunta al final de la zona reservada de pila
    
    # 2. MOSTRAR MENSAJE DE BIENVENIDA
    la    a0, msg_titulo             # a0 = dirección del mensaje de bienvenida
    jal   ra, ImprimirCadenaUART     # Imprimir por UART

    # 3. EJECUTAR BATERÍA DE PRUEBAS REQUERIDA EN ENTREGA 3
    jal   ra, ejecutar_bateria_pruebas

#------------------------------------------------------------------------------
# CICLO PRINCIPAL DE LA CALCULADORA INTERACTIVA
#------------------------------------------------------------------------------
ciclo_principal:
    # MOSTRAR PROMPT
    la    a0, msg_prompt             # a0 = dirección del mensaje "> "
    jal   ra, ImprimirCadenaUART     # Imprimir mensaje por UART

    # LEER EXPRESIÓN    
    la    a0, buffer_entrada         # a0 = dirección del buffer de entrada
    jal   ra, LeerLineaUART          # Leer entrada por UART hasta Enter

    # BUSCAR OPERADOR
    la    a0, buffer_entrada         # a0 = expresión completa
    jal   ra, BuscarOperador         # Buscar +, -, * o /

    addi  s0, a0, 0                  # s0 = operador encontrado
    addi  s1, a1, 0                  # s1 = dirección del segundo operando

    beq   s0, zero, error_operacion  # Si no hay operador -> error

###############################################################################
# OPERANDO 1
###############################################################################
    la    a0, buffer_entrada         # a0 = primer operando (ASCII)
    la    a1, bcd_op1                 # a1 = destino BCD
    jal   ra, ascii_a_bcd             # Convertir ASCII a BCD

    la    a0, bcd_op1                 # a0 = BCD operando 1
    jal   ra, bcd_a_float             # Convertir BCD -> FLOAT

    fmv.x.w t0, fa0                    # t0 = bits IEEE-754
    fmv.w.x fs0, t0                    # fs0 = operando 1 en float

###############################################################################
# OPERANDO 2
###############################################################################
    addi  a0, s1, 0                    # a0 = dirección del segundo operando
    la    a1, bcd_op2                 # a1 = destino BCD
    jal   ra, ascii_a_bcd             # Convertir ASCII a BCD

    la    a0, bcd_op2                 # a0 = BCD operando 2
    jal   ra, bcd_a_float             # Convertir BCD -> FLOAT

    fmv.x.w t0, fa0                    # t0 = bits IEEE-754
    fmv.w.x fs1, t0                    # fs1 = operando 2 en float

###############################################################################
# SELECCIONAR OPERACIÓN
###############################################################################
    addi  t0, zero, 43                # ASCII '+' = 43
    beq   s0, t0, op_suma

    addi  t0, zero, 45                # ASCII '-' = 45
    beq   s0, t0, op_resta

    addi  t0, zero, 42                # ASCII '*' = 42
    beq   s0, t0, op_mult

    addi  t0, zero, 47                # ASCII '/' = 47
    beq   s0, t0, op_div

    jal   zero, error_operacion       # Operador desconocido

#------------------------------------------------------------------------------
# OPERACIONES ARITMÉTICAS
#------------------------------------------------------------------------------
op_suma:
    fadd.s fa0, fs0, fs1              # fa0 = fs0 + fs1
    jal   zero, procesar_resultado

op_resta:
    fsub.s fa0, fs0, fs1              # fa0 = fs0 - fs1
    jal   zero, procesar_resultado

op_mult:
    fmul.s fa0, fs0, fs1              # fa0 = fs0 * fs1
    jal   zero, procesar_resultado

op_div:
    # Verificar si el divisor es cero
    fmv.x.w t0, fs1                    # t0 = bits del divisor
    la    t1, mascara_magnitud
    lw    t1, 0(t1)                   # t1 = 0x7FFFFFFF
    and   t0, t0, t1                  # Eliminar bit de signo

    beq   t0, zero, error_division_cero  # Si magnitud = 0 -> Div por cero

    fdiv.s fa0, fs0, fs1              # fa0 = fs0 / fs1
    jal   zero, procesar_resultado

#------------------------------------------------------------------------------
# PROCESAR RESULTADO
#------------------------------------------------------------------------------
procesar_resultado:
    la    a0, msg_igual              # Imprimir " = "
    jal   ra, ImprimirCadenaUART

    la    a0, bcd_res                 # a0 = destino BCD
    jal   ra, float_a_bcd             # Convertir FLOAT -> BCD

    lw    t0, 0(a0)                  # Leer código de estado

    addi  t1, zero, 2
    beq   t0, t1, error_float         # Código 2 -> Overflow/Error

    addi  t1, zero, 3
    beq   t0, t1, error_underflow     # Código 3 -> Underflow

    la    a0, bcd_res
    jal   ra, bcd_a_ascii             # Imprimir en ASCII por UART

    jal   zero, ciclo_principal       # Volver al ciclo interactivo

#------------------------------------------------------------------------------
# ERRORES
#------------------------------------------------------------------------------
error_division_cero:
    la    a0, msg_division_cero
    jal   ra, ImprimirCadenaUART
    jal   zero, ciclo_principal

error_float:
    la    a0, msg_error_float
    jal   ra, ImprimirCadenaUART
    jal   zero, ciclo_principal

error_underflow:
    la    a0, msg_underflow
    jal   ra, ImprimirCadenaUART
    jal   zero, ciclo_principal

error_operacion:
    la    a0, msg_error
    jal   ra, ImprimirCadenaUART
    jal   zero, ciclo_principal

###############################################################################
# BATERÍA DE PRUEBAS AUTOMÁTICA (ENTREGA 3)
###############################################################################
ejecutar_bateria_pruebas:
    addi  sp, sp, -36
    sw    ra, 0(sp)
    sw    s0, 4(sp)
    sw    s1, 8(sp)
    sw    s2, 12(sp)
    sw    s3, 16(sp)
    sw    s4, 20(sp)
    sw    s5, 24(sp)
    sw    s6, 28(sp)
    sw    s7, 32(sp)

    # Encabezado
    la    a0, msg_titulo_pruebas
    jal   ra, ImprimirCadenaUART

    la    t0, num_pruebas
    lw    s1, 0(t0)                   # s1 = total pruebas
    addi  s0, zero, 0                 # s0 = índice de prueba (0)
    addi  s2, zero, 0                 # s2 = pruebas pasadas
    addi  s3, zero, 0                 # s3 = errores detectados
    la    s4, tabla_pruebas           # s4 = puntero a la tabla de pruebas

bucle_pruebas:
    beq   s0, s1, fin_bateria_pruebas

    # Cargar elementos de la prueba actual
    lw    s5, 0(s4)                   # s5 = dirección ptr_op1
    lw    s6, 4(s4)                   # s6 = carácter operador (ASCII)
    lw    s7, 8(s4)                   # s7 = dirección ptr_op2

    # Convertir Operando 1: ASCII -> BCD -> FLOAT
    addi  a0, s5, 0
    la    a1, bcd_op1
    jal   ra, ascii_a_bcd

    la    a0, bcd_op1
    jal   ra, bcd_a_float
    fmv.x.w t0, fa0
    fmv.w.x fs0, t0

    # Convertir Operando 2: ASCII -> BCD -> FLOAT
    addi  a0, s7, 0
    la    a1, bcd_op2
    jal   ra, ascii_a_bcd

    la    a0, bcd_op2
    jal   ra, bcd_a_float
    fmv.x.w t0, fa0
    fmv.w.x fs1, t0

    # Seleccionar y ejecutar operación
    addi  t0, zero, 43                # '+'
    beq   s6, t0, test_op_suma

    addi  t0, zero, 45                # '-'
    beq   s6, t0, test_op_resta

    addi  t0, zero, 42                # '*'
    beq   s6, t0, test_op_mult

    addi  t0, zero, 47                # '/'
    beq   s6, t0, test_op_div

    addi  t0, zero, 2
    j     evaluar_resultado

test_op_suma:
    fadd.s fa0, fs0, fs1
    j     procesar_res_test

test_op_resta:
    fsub.s fa0, fs0, fs1
    j     procesar_res_test

test_op_mult:
    fmul.s fa0, fs0, fs1
    j     procesar_res_test

test_op_div:
    fmv.x.w t0, fs1
    la    t1, mascara_magnitud
    lw    t1, 0(t1)
    and   t0, t0, t1
    beq   t0, zero, es_div_zero_test
    fdiv.s fa0, fs0, fs1
    j     procesar_res_test

es_div_zero_test:
    addi  t0, zero, 4                 # Código 4 = división por cero
    j     evaluar_resultado

procesar_res_test:
    la    a0, bcd_res
    jal   ra, float_a_bcd
    la    a0, bcd_res
    lw    t0, 0(a0)                   # t0 = obt_code (0, 1, 2 o 3)

evaluar_resultado:
    # MOSTRAR LA OPERACIÓN Y SU RESULTADO POR UART: "Op1 Operador Op2 = Resultado"
    addi  sp, sp, -4
    sw    t0, 0(sp)                   # Guardar t0 temporalmente

    addi  a0, s5, 0                   # Op1
    jal   ra, ImprimirCadenaUART

    addi  a0, zero, 32                # Espacio ' '
    jal   ra, WriteUART

    addi  a0, s6, 0                   # Operador (+, -, *, /)
    jal   ra, WriteUART

    addi  a0, zero, 32                # Espacio ' '
    jal   ra, WriteUART

    addi  a0, s7, 0                   # Op2
    jal   ra, ImprimirCadenaUART

    la    a0, msg_igual               # " = "
    jal   ra, ImprimirCadenaUART

    lw    t0, 0(sp)                   # Recuperar t0
    addi  sp, sp, 4

    # Determinar qué imprimir después del "="
    addi  t2, zero, 4
    beq   t0, t2, pr_res_div0

    addi  t2, zero, 2
    beq   t0, t2, pr_res_ovf

    addi  t2, zero, 3
    beq   t0, t2, pr_res_und

    # Resultado numérico BCD
    la    a0, bcd_res
    jal   ra, bcd_a_ascii
    j     pr_res_fin

pr_res_div0:
    la    a0, msg_err_div0_short
    jal   ra, ImprimirCadenaUART
    j     pr_res_fin

pr_res_ovf:
    la    a0, msg_err_ovf_short
    jal   ra, ImprimirCadenaUART
    j     pr_res_fin

pr_res_und:
    la    a0, msg_err_und_short
    jal   ra, ImprimirCadenaUART

pr_res_fin:
    la    a0, msg_newline
    jal   ra, ImprimirCadenaUART

    # --- EVALUACIÓN DE ÉXITO O FALLO ---
    lw    t1, 12(s4)                  # t1 = exp_code esperada

    # Comprobar caso esperado 4 (Div Zero)
    addi  t2, zero, 4
    bne   t1, t2, chk_not_divzero
    beq   t0, t2, test_paso
    j     test_fallo

chk_not_divzero:
    # Comprobar caso esperado 2 (Overflow)
    addi  t2, zero, 2
    bne   t1, t2, chk_not_overflow
    beq   t0, t2, test_paso
    j     test_fallo

chk_not_overflow:
    # Comprobar caso esperado 3 (Underflow)
    addi  t2, zero, 3
    bne   t1, t2, chk_not_underflow
    beq   t0, t2, test_paso
    j     test_fallo

chk_not_underflow:
    # Caso normal (exp_code 0 o 1). Si obtuvo error (2, 3 o 4) -> Falló
    addi  t2, zero, 2
    beq   t0, t2, test_fallo
    addi  t2, zero, 3
    beq   t0, t2, test_fallo
    addi  t2, zero, 4
    beq   t0, t2, test_fallo

    # Comparar valor float con margen de tolerancia (epsilon)
    lw    t3, 16(s4)                  # ptr_exp_float
    flw   ft0, 0(t3)                  # ft0 = flotante esperado
    fsub.s ft1, fa0, ft0              # ft1 = fa0 - ft0

    # Obtener valor absoluto de la diferencia
    fmv.x.w t4, ft1
    la    t5, mascara_magnitud
    lw    t5, 0(t5)
    and   t4, t4, t5
    fmv.w.x ft1, t4                   # ft1 = |diferencia|

    # Comparar con epsilon (0.01)
    la    t5, constante_epsilon
    flw   ft2, 0(t5)
    flt.s t6, ft2, ft1                # t6 = 1 si 0.01 < |diferencia|
    bne   t6, zero, test_fallo

test_paso:
    addi  s2, s2, 1                   # Incrementar exitosas
    j     siguiente_prueba

test_fallo:
    addi  s3, s3, 1                   # Incrementar errores

siguiente_prueba:
    addi  s0, s0, 1                   # Siguiente prueba
    addi  s4, s4, 20                  # Avanzar en la tabla (20 bytes por entrada)
    j     bucle_pruebas

fin_bateria_pruebas:
    # Mostrar resumen de resultados
    la    a0, msg_resumen_hdr
    jal   ra, ImprimirCadenaUART

    la    a0, msg_total_p
    jal   ra, ImprimirCadenaUART
    addi  a0, s1, 0
    jal   ra, ImprimirEnteroUART

    la    a0, msg_exitosas_p
    jal   ra, ImprimirCadenaUART
    addi  a0, s2, 0
    jal   ra, ImprimirEnteroUART

    la    a0, msg_errores_p
    jal   ra, ImprimirCadenaUART
    addi  a0, s3, 0
    jal   ra, ImprimirEnteroUART

    la    a0, msg_fin_resumen
    jal   ra, ImprimirCadenaUART

    # Restaurar registros de pila
    lw    ra, 0(sp)
    lw    s0, 4(sp)
    lw    s1, 8(sp)
    lw    s2, 12(sp)
    lw    s3, 16(sp)
    lw    s4, 20(sp)
    lw    s5, 24(sp)
    lw    s6, 28(sp)
    lw    s7, 32(sp)
    addi  sp, sp, 36
    jr    ra

#------------------------------------------------------------------------------
# IMPRIMIR ENTERO POR UART (Para números pequeños <= 99)
#------------------------------------------------------------------------------
ImprimirEnteroUART:
    addi  sp, sp, -16
    sw    ra, 0(sp)
    sw    s0, 4(sp)
    sw    s1, 8(sp)

    addi  s0, a0, 0
    bne   s0, zero, conv_enteros_tabla

    addi  a0, zero, 48                # '0'
    jal   ra, WriteUART
    j     fin_imp_ent_uart

conv_enteros_tabla:
    addi  t0, zero, 10
    blt   s0, t0, solo_un_digito

    addi  s1, zero, 0                 # Contador de decenas

contar_decenas:
    blt   s0, t0, fin_contar_dec
    sub   s0, s0, t0
    addi  s1, s1, 1
    j     contar_decenas

fin_contar_dec:
    addi  a0, s1, 48                  # Imprimir decenas en ASCII
    jal   ra, WriteUART

solo_un_digito:
    addi  a0, s0, 48                  # Imprimir unidades en ASCII
    jal   ra, WriteUART

fin_imp_ent_uart:
    lw    ra, 0(sp)
    lw    s0, 4(sp)
    lw    s1, 8(sp)
    addi  sp, sp, 16
    jr    ra

###############################################################################
# ASCII -> BCD
###############################################################################
ascii_a_bcd:
    addi  t0, a1, 0
    addi  t1, zero, 16

limpiar_bcd:
    sw    zero, 0(t0)
    addi  t0, t0, 4
    addi  t1, t1, -1
    bne   t1, zero, limpiar_bcd

    addi  t0, zero, 0
    lb    t1, 0(a0)
    addi  t2, zero, 45                # ASCII '-'

    bne   t1, t2, contar_enteros
    addi  t0, zero, 1                 # Número negativo
    addi  a0, a0, 1

contar_enteros:
    sw    t0, 0(a1)                  # Guardar signo en palabra 0

    addi  t0, a0, 0
    addi  t1, zero, 0

contar_loop:
    lb    t2, 0(t0)
    beq   t2, zero, fin_contar

    addi  t3, zero, 46               # ASCII '.'
    beq   t2, t3, fin_contar

    addi  t3, zero, 48               # '0'
    blt   t2, t3, fin_contar

    addi  t3, zero, 57               # '9'
    blt   t3, t2, fin_contar

    addi  t1, t1, 1
    addi  t0, t0, 1
    jal   zero, contar_loop

fin_contar:
    addi  t2, zero, 10
    sub   t2, t2, t1                 # Posiciones vacías

    addi  t3, zero, 0
    addi  t4, zero, 0

multiplicar_offset:
    beq   t4, t2, fin_offset
    addi  t3, t3, 4
    addi  t4, t4, 1
    jal   zero, multiplicar_offset

fin_offset:
    addi  t2, t3, 4
    add   t0, a1, t2

escribir_enteros:
    beq   t1, zero, chequear_decimal
    lb    t2, 0(a0)
    addi  t3, zero, 48
    sub   t2, t2, t3
    sw    t2, 0(t0)
    addi  t0, t0, 4
    addi  a0, a0, 1
    addi  t1, t1, -1
    jal   zero, escribir_enteros

chequear_decimal:
    lb    t2, 0(a0)
    addi  t3, zero, 46               # '.'
    bne   t2, t3, fin_ascii_bcd
    addi  a0, a0, 1

    addi  t0, a1, 44                 # Palabra 11 (offset 44)
    addi  t1, zero, 5

escribir_decimales:
    beq   t1, zero, fin_ascii_bcd
    lb    t2, 0(a0)
    beq   t2, zero, fin_ascii_bcd

    addi  t3, zero, 48
    blt   t2, t3, fin_ascii_bcd
    addi  t3, zero, 57
    blt   t3, t2, fin_ascii_bcd

    addi  t3, zero, 48
    sub   t2, t2, t3
    sw    t2, 0(t0)
    addi  t0, t0, 4
    addi  a0, a0, 1
    addi  t1, t1, -1
    jal   zero, escribir_decimales

fin_ascii_bcd:
    jr    ra

###############################################################################
# BCD -> ASCII
###############################################################################
bcd_a_ascii:
    addi  sp, sp, -16
    sw    ra, 0(sp)
    sw    s0, 4(sp)
    sw    s1, 8(sp)
    sw    s2, 12(sp)

    addi  s0, a0, 0
    lw    t0, 0(s0)                  # Leer signo

    beq   t0, zero, omitir_signo
    addi  a0, zero, 45               # '-'
    jal   ra, WriteUART

omitir_signo:
    addi  s1, s0, 4                  # Primer entero
    addi  s2, zero, 10               # 10 enteros

bucle_imp_ent:
    lw    a0, 0(s1)
    addi  a0, a0, 48
    jal   ra, WriteUART
    addi  s1, s1, 4
    addi  s2, s2, -1
    bne   s2, zero, bucle_imp_ent

    addi  a0, zero, 46               # '.'
    jal   ra, WriteUART

    addi  s2, zero, 5                # 5 decimales

bucle_imp_dec:
    lw    a0, 0(s1)
    addi  a0, a0, 48
    jal   ra, WriteUART
    addi  s1, s1, 4
    addi  s2, s2, -1
    bne   s2, zero, bucle_imp_dec

    lw    ra, 0(sp)
    lw    s0, 4(sp)
    lw    s1, 8(sp)
    lw    s2, 12(sp)
    addi  sp, sp, 16
    jr    ra

###############################################################################
# BCD -> FLOAT
###############################################################################
bcd_a_float:
    lw    t0, 0(a0)                  # t0 = signo (0: +, 1: -)
    addi  a0, a0, 4

    # Inicializar fa0 = 0.0 para la acumulación entera directamente en FPU
    fcvt.s.w fa0, zero

    la    t1, potencias10_10dig
    addi  t3, zero, 10

bucle_entero:
    beq   t3, zero, fin_entero
    lw    t4, 0(a0)                  # t4 = dígito entero actual
    beq   t4, zero, sig_digito_entero

    fcvt.s.w ft0, t4                 # Convertir dígito a flotante
    lw    t5, 0(t1)                  # Cargar potencia de 10
    fcvt.s.w ft1, t5                 # Convertir potencia a flotante
    fmul.s ft0, ft0, ft1             # ft0 = dígito * potencia
    fadd.s fa0, fa0, ft0             # Sumar al acumulador flotante

sig_digito_entero:
    addi  a0, a0, 4
    addi  t1, t1, 4
    addi  t3, t3, -1
    j     bucle_entero

fin_entero:
    fcvt.s.w ft3, zero               # ft3 = 0.0 (Acumulador decimal flotante)
    la    t1, potencias10_5dig
    addi  t3, zero, 5

bucle_decimal:
    beq   t3, zero, fin_decimal
    lw    t4, 0(a0)                  # t4 = dígito decimal actual
    beq   t4, zero, sig_digito_decimal

    fcvt.s.w ft0, t4                 # Convertir dígito a flotante
    lw    t5, 0(t1)                  # Cargar potencia decimal
    fcvt.s.w ft1, t5                 # Convertir potencia a flotante
    fmul.s ft0, ft0, ft1             # ft0 = dígito * potencia
    fadd.s ft3, ft3, ft0             # Sumar al acumulador decimal

sig_digito_decimal:
    addi  a0, a0, 4
    addi  t1, t1, 4
    addi  t3, t3, -1
    j     bucle_decimal

fin_decimal:
    la    t1, constante_100000
    flw   ft2, 0(t1)
    fdiv.s ft3, ft3, ft2             # Normalizar parte decimal (ft3 / 100000.0)
    fadd.s fa0, fa0, ft3             # fa0 = parte_entera + parte_decimal

    beq   t0, zero, fin_bcd2float
    la    t1, menos_un_float
    flw   ft2, 0(t1)
    fmul.s fa0, fa0, ft2             # Aplicar signo negativo si aplica

fin_bcd2float:
    jr    ra

###############################################################################
# FLOAT -> BCD (CORREGIDO LÍMITE SUPERIOR DE OVERFLOW)
###############################################################################
float_a_bcd:
    fmv.x.w t0, fa0
    la    t1, mascara_exponente
    lw    t1, 0(t1)
    and   t2, t0, t1
    beq   t2, t1, caso_error_float2bcd

    la    t1, mascara_magnitud
    lw    t1, 0(t1)
    and   t3, t0, t1
    beq   t3, zero, caso_cero_float2bcd

    la    t4, limite_underflow
    lw    t4, 0(t4)
    blt   t3, t4, caso_underflow_float2bcd

    la    t4, limite_overflow
    lw    t4, 0(t4)
    bgeu  t3, t4, caso_error_float2bcd   # CORRECCIÓN: bgeu en lugar de blt

    la    t1, mascara_signo
    lw    t1, 0(t1)
    and   t1, t0, t1
    beq   t1, zero, signo_positivo
    addi  t1, zero, 1

signo_positivo:
    sw    t1, 0(a0)

    fmv.x.w t0, fa0
    la    t1, mascara_magnitud
    lw    t1, 0(t1)
    and   t0, t0, t1
    fmv.w.x ft0, t0

    fcvt.w.s t2, ft0, rtz
    fcvt.s.w ft1, t2
    fsub.s ft2, ft0, ft1

    la    t1, constante_100000
    flw   ft3, 0(t1)
    fmul.s ft2, ft2, ft3
    fcvt.w.s a3, ft2, rne

    addi  a1, a0, 4
    addi  a2, t2, 0
    la    t1, potencias10_10dig
    addi  t3, zero, 10

desc_entero_loop:
    beq   t3, zero, fin_desc_entero
    lw    t5, 0(t1)
    addi  t4, zero, 0

restas_entero_loop:
    blt   a2, t5, fin_restas_entero
    sub   a2, a2, t5
    addi  t4, t4, 1
    jal   zero, restas_entero_loop

fin_restas_entero:
    sw    t4, 0(a1)
    addi  a1, a1, 4
    addi  t1, t1, 4
    addi  t3, t3, -1
    jal   zero, desc_entero_loop

fin_desc_entero:
    addi  a1, a0, 44
    addi  a2, a3, 0
    la    t1, potencias10_5dig
    addi  t3, zero, 5

desc_decimal_loop:
    beq   t3, zero, fin_desc_decimal
    lw    t5, 0(t1)
    addi  t4, zero, 0

restas_decimal_loop:
    blt   a2, t5, fin_restas_decimal
    sub   a2, a2, t5
    addi  t4, t4, 1
    jal   zero, restas_decimal_loop

fin_restas_decimal:
    sw    t4, 0(a1)
    addi  a1, a1, 4
    addi  t1, t1, 4
    addi  t3, t3, -1
    jal   zero, desc_decimal_loop

fin_desc_decimal:
    jr    ra

caso_cero_float2bcd:
    fmv.x.w t0, fa0
    la    t1, mascara_signo
    lw    t1, 0(t1)
    and   t1, t0, t1
    beq   t1, zero, cero_positivo
    addi  t1, zero, 1

cero_positivo:
    sw    t1, 0(a0)
    jal   zero, limpiar_digitos_bcd

caso_error_float2bcd:
    addi  t1, zero, 2                 # Código 2 = Error/Overflow
    sw    t1, 0(a0)
    jal   zero, limpiar_digitos_bcd

caso_underflow_float2bcd:
    addi  t1, zero, 3                 # Código 3 = Underflow
    sw    t1, 0(a0)

limpiar_digitos_bcd:
    addi  a1, a0, 4
    addi  t2, zero, 15

bucle_limpiar:
    beq   t2, zero, ret_float2bcd
    sw    zero, 0(a1)
    addi  a1, a1, 4
    addi  t2, t2, -1
    jal   zero, bucle_limpiar

ret_float2bcd:
    jr    ra

###############################################################################
# COMUNICACIÓN UART
###############################################################################
WriteUART:
    la    t0, WriteAddrUART
    lw    t0, 0(t0)

esperar_WSPACE:
    lw    t1, 4(t0)
    la    t2, mascara_WSPACE
    lw    t2, 0(t2)
    and   t1, t1, t2
    beq   t1, zero, esperar_WSPACE

    sw    a0, 0(t0)
    jr    ra

ReadUART:
    la    t0, ReadAddrUART
    lw    t0, 0(t0)
    lw    a0, 0(t0)
    jr    ra

DELChar:
    addi  sp, sp, -4
    sw    ra, 0(sp)

    addi  a0, zero, 8
    jal   ra, WriteUART
    addi  a0, zero, 32
    jal   ra, WriteUART
    addi  a0, zero, 8
    jal   ra, WriteUART

    lw    ra, 0(sp)
    addi  sp, sp, 4
    jr    ra

LeerLineaUART:
    addi  sp, sp, -12
    sw    ra, 0(sp)
    sw    s0, 4(sp)
    sw    s1, 8(sp)

    addi  s0, a0, 0
    addi  s1, a0, 0

bucle_lectura_linea:
    jal   ra, ReadUART
    la    t0, OchoMil
    lw    t0, 0(t0)
    and   t0, t0, a0
    beq   t0, zero, bucle_lectura_linea

    andi  a0, a0, 0xFF

    addi  t0, zero, 13                # CR
    beq   a0, t0, fin_lectura_linea

    addi  t0, zero, 10                # LF
    beq   a0, t0, fin_lectura_linea

    addi  t0, zero, 127               # DEL
    beq   a0, t0, procesar_borrado

    addi  t0, zero, 8                 # Backspace
    beq   a0, t0, procesar_borrado

    sb    a0, 0(s0)
    addi  s0, s0, 1
    jal   ra, WriteUART
    jal   zero, bucle_lectura_linea

procesar_borrado:
    beq   s0, s1, bucle_lectura_linea
    addi  s0, s0, -1
    jal   ra, DELChar
    jal   zero, bucle_lectura_linea

fin_lectura_linea:
    sb    zero, 0(s0)
    lw    ra, 0(sp)
    lw    s0, 4(sp)
    lw    s1, 8(sp)
    addi  sp, sp, 12
    jr    ra

ImprimirCadenaUART:
    addi  sp, sp, -8
    sw    ra, 0(sp)
    sw    s0, 4(sp)

    addi  s0, a0, 0

bucle_imp_cadena:
    lb    a0, 0(s0)
    beq   a0, zero, fin_imp_cadena
    jal   ra, WriteUART
    addi  s0, s0, 1
    jal   zero, bucle_imp_cadena

fin_imp_cadena:
    lw    ra, 0(sp)
    lw    s0, 4(sp)
    addi  sp, sp, 8
    jr    ra

BuscarOperador:
    addi  t0, a0, 0
    lb    t1, 0(t0)
    addi  t2, zero, 45                # '-'

    bne   t1, t2, bucle_buscar_op
    addi  t0, t0, 1

bucle_buscar_op:
    lb    t1, 0(t0)
    beq   t1, zero, no_encontrado_op

    addi  t2, zero, 43                # '+'
    beq   t1, t2, op_encontrado

    addi  t2, zero, 45                # '-'
    beq   t1, t2, op_encontrado

    addi  t2, zero, 42                # '*'
    beq   t1, t2, op_encontrado

    addi  t2, zero, 47                # '/'
    beq   t1, t2, op_encontrado

    addi  t0, t0, 1
    jal   zero, bucle_buscar_op

op_encontrado:
    sb    zero, 0(t0)
    addi  a0, t1, 0
    addi  a1, t0, 1
    jr    ra

no_encontrado_op:
    addi  a0, zero, 0
    addi  a1, zero, 0
    jr    ra

