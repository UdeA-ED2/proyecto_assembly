.global _start

_start:

main:
    # Inicialización de punteros a las estructuras de memoria y contadores.
	
    la   s0, pruebas_bcd          # s0 = Puntero al número BCD actual en memoria
    la   s1, floats_esperados     # s1 = Puntero a la tabla de resultados correctos
    la   s2, resultados_obtenidos # s2 = Puntero al buffer donde guardaremos las respuestas

    la   t0, num_pruebas          # Cargamos la dirección del número de pruebas
    lw   s3, 0(t0)                # s3 = Cantidad total de pruebas pendientes a ejecutar

    addi s4, zero, 0              # s4 = Contador de pruebas fallidas (inicia en 0)


bucle_pruebas:
    # Evaluar si quedan pruebas pendientes por procesar
    beq  s3, zero, fin_pruebas    # Si s3 == 0, terminamos las ejecuciones ya no hay pruebas


    # Preparar argumento y llamar a la función de conversión
    addi a0, s0, 0                # a0 = Dirección base del número BCD actual
    jal  ra, bcd_a_float          # Llamada a subrutina (retorna el resultado en a0)

    # Guardar el resultado en la memoria de resultados
    sw   a0, 0(s2)                # Guardamos el float (IEEE-754) obtenido en resultados_obtenidos


    # Comparación de respuesta contra valor esperado
    lw   t0, 0(s1)                # Cargamos el valor float esperado
    beq  a0, t0, prueba_correcta  # Si a0 == t0, no se incrementa el contador de errores

    addi s4, s4, 1                # Si son diferentes, incrementamos contador de errores en 1


prueba_correcta:
    # Avanzar punteros para la siguiente iteración
    addi s0, s0, 64               # Avanzamos al siguiente BCD (16 words * 4 bytes = 64 bytes)
    addi s1, s1, 4                # Avanzamos 1 word (4 bytes) en floats esperados
    addi s2, s2, 4                # Avanzamos 1 word (4 bytes) en resultados obtenidos

    addi s3, s3, -1               # Decrementamos en 1 el número de pruebas pendientes
    jal  zero, bucle_pruebas      # Repetir el ciclo


fin_pruebas:
    # Almacenar el reporte final de errores
    la   t0, total_errores
    sw   s4, 0(t0)                # Guardamos el número final de errores en la variable total_errores


fin:
    # Detener el procesador en bucle infinito
    jal  zero, fin


bcd_a_float: # BLOQUE 1: Carga inicial de datos desde la memoria BCD
    addi a2, a0, 0                # a2 = Puntero de lectura que recorrerá el BCD
    lw   a1, 0(a2)                # a1 = Signo (0 o 1)

    addi a3, zero, 0              # a3 = Variable acumuladora para la parte entera
    addi a4, zero, 0              # a4 = Variable acumuladora para la parte fraccionaria


    #Reconstrucción matemática de la Parte Entera
    # Algoritmo: valor = (valor * 10) + nuevo_digito
    # Donde: x * 10 = (x * 8) + (x * 2) mediante sumas sucesivas.
	
    addi a2, a2, 4                # Avanzar puntero al primer dígito entero [1]
    addi t0, zero, 10             # Contador para procesar los 10 dígitos enteros


construir_entero:
    beq  t0, zero, entero_terminado

    lw   t1, 0(a2)                # t1 = Dígito BCD actual

    add  t2, a3, a3               # t2 = valor_entero * 2
    add  t3, t2, t2               # t3 = valor_entero * 4
    add  t3, t3, t3               # t3 = valor_entero * 8
    add  t3, t3, t2               # t3 = (valor_entero * 8) + (valor_entero * 2) = valor_entero * 10

    add  a3, t3, t1               # a3 = (valor_entero * 10) + digito_actual

    addi a2, a2, 4                # Siguiente dígito en memoria
    addi t0, t0, -1               # Decrementar contador de dígitos
    jal  zero, construir_entero

entero_terminado: #Reconstrucción matemática de la Parte Fraccionaria
    			  # Se leen los 5 dígitos y se acumulan como número entero en a4.
   				  # Representa la fracción: a4 / 100000
				  
    addi t0, zero, 5              # Contador para los 5 dígitos decimales


construir_fraccion:
    beq  t0, zero, fraccion_terminada

    lw   t1, 0(a2)                # t1 = Dígito decimal actual

    add  t2, a4, a4               # t2 = fraccion * 2
    add  t3, t2, t2               # t3 = fraccion * 4
    add  t3, t3, t3               # t3 = fraccion * 8
    add  t3, t3, t2               # t3 = fraccion * 10

    add  a4, t3, t1               # a4 = (fraccion * 10) + digito_actual

    addi a2, a2, 4                # Siguiente dígito decimal
    addi t0, t0, -1               # Decrementar contador
    jal  zero, construir_fraccion


fraccion_terminada:#Manejo especial del Caso Cero (0.0)
    # Si Entero == 0 y Fracción == 0, se construye directamente el cero float
    bne  a3, zero, hay_numero
    bne  a4, zero, hay_numero

    beq  a1, zero, cero_positivo  # Si signo es 0 -> +0.0 (0x00000000)


    # Construcción manual de -0.0 (0x80000000) desplazando un '1' 31 posiciones
    addi a0, zero, 1
    addi t0, zero, 31


crear_negativo_cero:
    add  a0, a0, a0               # a0 = a0 << 1
    addi t0, t0, -1
    bne  t0, zero, crear_negativo_cero
    jr   ra                       # Retornar 0x80000000


cero_positivo:
    addi a0, zero, 0              # Retornar 0x00000000
    jr   ra


hay_numero: #Bifurcación entre número >= 1 o número entre 0 y 1
	bne  a3, zero, caso_entero    # Si parte entera != 0, procesar caso >= 1
    jal  zero, caso_fraccion      # Si parte entera == 0, procesar caso < 1


# PROCESAMIENTO: Números con Parte Entera (>= 1.0)
#------------------------------------------------------------------------------------
caso_entero:
    #Búsqueda de la mayor potencia de 2 (2^E) <= Parte Entera
    addi t5, zero, 1              # t5 = Potencia acumulada (inicia en 2^0 = 1)
    addi t4, zero, 0              # t4 = Exponente E


buscar_potencia:
    addi t0, zero, 30             # Límite superior de exponente de seguridad
    bge  t4, t0, potencia_encontrada

    add  t2, t5, t5               # t2 = potencia_actual * 2
    bge  a3, t2, aumentar_potencia # Si entero >= 2*potencia, continuar escalando
    jal  zero, potencia_encontrada


aumentar_potencia:
    addi t5, t2, 0                # Actualizar potencia
    addi t4, t4, 1                # Incrementar exponente E
    jal  zero, buscar_potencia


potencia_encontrada: #Cálculo de residuos tras extraer el 1 implícito
    sub  t6, a3, t5               # t6 = Residuo de la parte entera
    addi t3, a4, 0                # t3 = Residuo de la parte decimal (escala /100000)


    #Generación iterativa de los 23 bits de la mantisa
    addi t0, zero, 23             # Contador para generar 23 bits
    addi a2, zero, 0              # a2 = Registro que construirá la mantisa


bits_entero:
    beq  t0, zero, bit_redondeo_entero

    add  t6, t6, t6               # Multiplicar residuo entero por 2
    add  t3, t3, t3               # Multiplicar residuo decimal por 2

    la   t1, cien_mil
    lw   t1, 0(t1)

    bge  t3, t1, decimal_entero    # Si el decimal pasa de 100000, genera acarreo entero
    jal  zero, comprobar_bit_entero


decimal_entero:
    sub  t3, t3, t1               # Descontar 1.0 (100000) de la parte decimal
    addi t6, t6, 1                # Sumar acarreo al residuo entero


comprobar_bit_entero:
    bge  t6, t5, bit_entero_uno   # Si residuo >= 2^E, el bit binario es 1

    add  a2, a2, a2               # Bit = 0 (mantisa << 1)
    addi t0, t0, -1
    jal  zero, bits_entero


bit_entero_uno:
    sub  t6, t6, t5               # Restar 2^E del residuo
    add  a2, a2, a2
    addi a2, a2, 1                # Bit = 1 (mantisa << 1 | 1)
    addi t0, t0, -1
    jal  zero, bits_entero


bit_redondeo_entero:
    # ---------------------------------------------------------------
    # BLOQUE 8: Extracción del bit 24 para aplicación de redondeo
    # Aplica norma IEEE-754 "Round to Nearest, Ties to Even"
    # ---------------------------------------------------------------
    add  t6, t6, t6
    add  t3, t3, t3

    la   t1, cien_mil
    lw   t1, 0(t1)

    bge  t3, t1, redondeo_decimal_entero
    jal  zero, comprobar_redondeo_entero


redondeo_decimal_entero:
    sub  t3, t3, t1
    addi t6, t6, 1


comprobar_redondeo_entero:
    bge  t6, t5, hay_bit_redondeo_entero
    jal  zero, ensamblar_entero


hay_bit_redondeo_entero:
    sub  t6, t6, t5

    # Evaluar empates de redondeo
    bne  t6, zero, hacer_redondeo_entero
    bne  t3, zero, hacer_redondeo_entero
    andi t1, a2, 1
    bne  t1, zero, hacer_redondeo_entero # Si es impar, redondear
    jal  zero, ensamblar_entero


hacer_redondeo_entero:
    addi a2, a2, 1                # Redondear mantisa (+1)

    # Evaluar si ocurrió desbordamiento de la mantisa de 23 bits (alcanza 2^23)
    addi t1, zero, 1
    addi t2, zero, 23


crear_limite_mantisa:
    add  t1, t1, t1
    addi t2, t2, -1
    bne  t2, zero, crear_limite_mantisa

    beq  a2, t1, desbordamiento_mantisa_entero
    jal  zero, ensamblar_entero


desbordamiento_mantisa_entero:
    addi a2, zero, 0              # Reiniciar mantisa a 0
    addi t4, t4, 1                # Incrementar exponente en 1



#####################################################################
# PROCESAMIENTO: Números estrictamente menores a 1.0 (0.x)
#####################################################################

caso_fraccion:

    # ---------------------------------------------------------------
    # BLOQUE 9: Normalización de números entre 0 y 1
    # Multiplica sucesivamente la fracción por 2 hasta encontrar el primer 1
    # ---------------------------------------------------------------
    addi t4, zero, 0              # Exponente E = 0
    addi t3, a4, 0                # Cargar residuo decimal


normalizar_fraccion:
    la   t1, cien_mil
    lw   t1, 0(t1)

    bge  t3, t1, fraccion_normalizada # Detener al alcanzar 1.0 (100000)

    add  t3, t3, t3               # Fracción = Fracción * 2
    addi t4, t4, -1               # Reducir exponente E (E = E - 1)
    jal  zero, normalizar_fraccion


fraccion_normalizada:
    sub  t3, t3, t1               # Extraer el 1 implícito (restar 100000)


    # ---------------------------------------------------------------
    # BLOQUE 10: Extracción de 23 bits para la mantisa
    # ---------------------------------------------------------------
    addi a2, zero, 0              # Acumulador de mantisa
    addi t0, zero, 23             # Contador de 23 bits


bits_fraccion:
    beq  t0, zero, bit_redondeo_fraccion

    add  t3, t3, t3               # Fracción = Fracción * 2

    la   t1, cien_mil
    lw   t1, 0(t1)

    bge  t3, t1, bit_fraccion_uno

    add  a2, a2, a2               # Bit = 0
    addi t0, t0, -1
    jal  zero, bits_fraccion


bit_fraccion_uno:
    sub  t3, t3, t1               # Restar 1.0 (100000)
    add  a2, a2, a2
    addi a2, a2, 1                # Bit = 1
    addi t0, t0, -1
    jal  zero, bits_fraccion


bit_redondeo_fraccion:
    # ---------------------------------------------------------------
    # BLOQUE 11: Bit extra de redondeo para casos < 1.0
    # ---------------------------------------------------------------
    add  t3, t3, t3

    la   t1, cien_mil
    lw   t1, 0(t1)

    bge  t3, t1, redondeo_fraccion_bit_uno
    jal  zero, ensamblar_fraccion


redondeo_fraccion_bit_uno:
    sub  t3, t3, t1

    bne  t3, zero, hacer_redondeo_fraccion
    andi t1, a2, 1
    bne  t1, zero, hacer_redondeo_fraccion
    jal  zero, ensamblar_fraccion


hacer_redondeo_fraccion:
    addi a2, a2, 1                # Redondear mantisa

    addi t1, zero, 1
    addi t2, zero, 23


crear_limite_fraccion:
    add  t1, t1, t1
    addi t2, t2, -1
    bne  t2, zero, crear_limite_fraccion

    beq  a2, t1, desbordamiento_mantisa_fraccion
    jal  zero, ensamblar_fraccion


desbordamiento_mantisa_fraccion:
    addi a2, zero, 0
    addi t4, t4, 1                # Corregir exponente tras desbordamiento



#####################################################################
# ENSAMBLADO FINAL: Formato IEEE-754 [Signo | Exponente | Mantisa]
#####################################################################

ensamblar_entero:
    # ---------------------------------------------------------------
    # BLOQUE 12: Sesgar exponente (E + 127) y desplazar a bits 30:23
    # ---------------------------------------------------------------
    addi t4, t4, 127              # Aplicar sesgo IEEE-754

    addi t1, zero, 23             # 23 desplazamientos hacia la izquierda
    addi t5, t4, 0


multiplicar_exponente_entero:
    beq  t1, zero, juntar_entero
    add  t5, t5, t5               # t5 = t5 << 1 (mediante suma)
    addi t1, t1, -1
    jal  zero, multiplicar_exponente_entero


juntar_entero:
    add  a0, t5, a2               # Unir Exponente desplazado + Mantisa


    # ---------------------------------------------------------------
    # BLOQUE 13: Aplicar Bit de Signo (Bit 31)
    # ---------------------------------------------------------------
    beq  a1, zero, float_positivo_entero

    # Crear la máscara 0x80000000
    addi t0, zero, 1
    addi t1, zero, 31


crear_signo_entero:
    add  t0, t0, t0               # t0 = t0 << 1
    addi t1, t1, -1
    bne  t1, zero, crear_signo_entero

    add  a0, a0, t0               # Insertar bit de signo en la posición 31


float_positivo_entero:
    jr   ra                       # Retornar valor float ensamblado



ensamblar_fraccion:
    # ---------------------------------------------------------------
    # BLOQUE 14: Ensamblado idéntico para casos < 1.0
    # ---------------------------------------------------------------
    addi t4, t4, 127              # Sesgo del exponente

    addi t1, zero, 23
    addi t5, t4, 0


multiplicar_exponente_fraccion:
    beq  t1, zero, juntar_fraccion
    add  t5, t5, t5
    addi t1, t1, -1
    jal  zero, multiplicar_exponente_fraccion


juntar_fraccion:
    add  a0, t5, a2               # Unir Exponente desplazado + Mantisa

    beq  a1, zero, float_positivo_fraccion

    addi t0, zero, 1
    addi t1, zero, 31


crear_signo_fraccion:
    add  t0, t0, t0
    addi t1, t1, -1
    bne  t1, zero, crear_signo_fraccion

    add  a0, a0, t0               # Insertar bit de signo


float_positivo_fraccion:
    jr   ra                       # Retornar de la función


#####################################################################
# SUBRUTINA: float_a_bcd
# Convierte un valor IEEE-754 (a0) a su representación BCD en memoria (a1)
# Entrada: a0 = Valor float (32 bits IEEE-754)
#          a1 = Puntero a la estructura BCD de salida (16 words)
#####################################################################

float_a_bcd:
    addi sp, sp, -16              # Reservar espacio en pila
    sw   ra, 12(sp)
    sw   s2, 8(sp)
    sw   s1, 4(sp)
    sw   s0, 0(sp)

    addi s0, a0, 0                 # s0 = Float de entrada
    addi s1, a1, 0                 # s1 = Puntero de destino BCD

    # ---------------------------------------------------------------
    # Extraer Bit de Signo (Bit 31)
    # ---------------------------------------------------------------
    srli t0, s0, 31
    sw   t0, 0(s1)                 # Guardar signo en la primera posición (word 0)

    # ---------------------------------------------------------------
    # Extraer Exponente (Bits 30:23) y Mantisa (Bits 22:0)
    # ---------------------------------------------------------------
    srli t1, s0, 23
    andi t1, t1, 0xFF              # Exponente con sesgo

    addi t2, zero, 1
    slli t2, t2, 23
    addi t2, t2, -1
    and  t3, s0, t2                # t3 = Mantisa de 23 bits

    # ---------------------------------------------------------------
    # Validar Casos Especiales: Cero / Subnormales / Infinitos
    # ---------------------------------------------------------------
    addi t4, zero, 255
    beq  t1, t4, marcar_error_bcd  # Exponente 255 -> Infinito/NaN (Error)

    beq  t1, zero, marcar_cero_bcd # Exponente 0 -> Subnormal o Cero exacto

    addi t5, t1, -127              # t5 = Exponente real E (E = sesgado - 127)
    addi t6, zero, -17
    blt  t5, t6, marcar_cero_bcd    # Exponente muy pequeño (< 2^-17) se lleva a 0.0

    addi t6, zero, 31
    bge  t5, t6, marcar_error_bcd   # Fuera de rango del entero -> Error

    # ---------------------------------------------------------------
    # Agregar '1' implícito a la mantisa en el bit 23
    # ---------------------------------------------------------------
    addi t4, zero, 1
    slli t4, t4, 23
    or   t3, t3, t4                # Mantisa completa en t3 (1.M)

    # ---------------------------------------------------------------
    # Descomponer en Parte Entera y Fraccionaria según Exponente Real E
    # ---------------------------------------------------------------
    blt  t5, zero, float_solo_decimal_bcd

    addi t4, zero, 23
    sub  t4, t4, t5                # Desplazamiento a la derecha
    blt  t4, zero, entero_desplaza_izq_bcd

    srl  s2, t3, t4                # s2 = Parte entera binaria
    addi t6, zero, 1
    sll  t6, t6, t4
    addi t6, t6, -1
    and  t3, t3, t6                # t3 = Residuo decimal binario
    jal  zero, calcular_fraccion_bcd

entero_desplaza_izq_bcd:
    sub  t4, zero, t4
    sll  s2, t3, t4                # s2 = Parte entera binaria
    addi t3, zero, 0               # Sin residuo decimal
    jal  zero, calcular_fraccion_bcd

float_solo_decimal_bcd:
    addi s2, zero, 0               # Parte entera = 0

calcular_fraccion_bcd:
    # Escalado de la fracción por 100000 para obtener dígitos enteros
    la   t0, cien_mil
    lw   t0, 0(t0)
    mul  t3, t3, t0
    srli t3, t3, 23                # t3 = Parte decimal en rango 0..99999

    # ---------------------------------------------------------------
    # Escribir Parte Entera a estructura BCD (10 words)
    # ---------------------------------------------------------------
    addi a0, s2, 0
    addi a1, s1, 4                 # Avanzar al word 1 (inicio entero)
    addi a2, zero, 10
    jal  ra, binario_a_bcd_words

    # ---------------------------------------------------------------
    # Escribir Parte Fraccionaria a estructura BCD (5 words)
    # ---------------------------------------------------------------
    addi a0, t3, 0
    addi a1, s1, 44                # Avanzar al word 11 (inicio decimal)
    addi a2, zero, 5
    jal  ra, binario_a_bcd_words

    jal  zero, retorno_float_bcd

marcar_cero_bcd:
    # Llenar la estructura BCD con 0s en sus 15 dígitos
    addi t0, zero, 4
    addi t1, zero, 64
limpiar_cero_loop:
    beq  t0, t1, retorno_float_bcd
    add  t2, s1, t0
    sw   zero, 0(t2)
    addi t0, t0, 4
    jal  zero, limpiar_cero_loop

marcar_error_bcd:
    # Llenar la estructura BCD con 9s indicando desbordamiento/error
    addi t0, zero, 4
    addi t1, zero, 64
    addi t3, zero, 9
limpiar_error_loop:
    beq  t0, t1, retorno_float_bcd
    add  t2, s1, t0
    sw   t3, 0(t2)
    addi t0, t0, 4
    jal  zero, limpiar_error_loop

retorno_float_bcd:
    lw   s0, 0(sp)
    lw   s1, 4(sp)
    lw   s2, 8(sp)
    lw   ra, 12(sp)
    addi sp, sp, 16
    jr   ra


#####################################################################
# HELPER: binario_a_bcd_words
# Convierte un entero a N dígitos BCD en palabras (.word)
#####################################################################
binario_a_bcd_words:
    addi t0, a2, -1                # Índice local desde la derecha
    slli t0, t0, 2                 # Offset en bytes (índice * 4)

div_loop_words:
    blt  t0, zero, ret_bin_bcd_words
    addi t1, zero, 10
    rem  t2, a0, t1                # Dígito = a0 % 10
    div  a0, a0, t1                # a0 = a0 / 10

    add  t3, a1, t0
    sw   t2, 0(t3)                 # Almacenar dígito BCD en word
    addi t0, t0, -4
    jal  zero, div_loop_words

ret_bin_bcd_words:
    jr   ra



